<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primary Brand Colors: Professional Deep Blue & Gold Accent -->
    <Color x:Key="PrimaryDeepBlueColor">#1E3A8A</Color>
    <Color x:Key="PrimaryLightBlueColor">#2563EB</Color>
    <Color x:Key="PrimaryDarkBlueColor">#0F172A</Color>
    <Color x:Key="BrandGoldColor">#B8860B</Color>
    <Color x:Key="BrandGoldLightColor">#DAA520</Color>

    <!-- Neutral Background & Surface Colors -->
    <Color x:Key="AppBackgroundColor">#F8FAFC</Color>
    <Color x:Key="SurfaceCardColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F5F9</Color>
    <Color x:Key="BorderLightColor">#E2E8F0</Color>
    <Color x:Key="BorderMediumColor">#CBD5E1</Color>
    <Color x:Key="BorderFocusColor">#2563EB</Color>

    <!-- Typography Text Colors -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextInverseColor">#FFFFFF</Color>

    <!-- Semantic Feedback Colors -->
    <Color x:Key="SuccessGreenColor">#16A34A</Color>
    <Color x:Key="SuccessGreenBgColor">#DCFCE7</Color>
    <Color x:Key="DangerRedColor">#DC2626</Color>
    <Color x:Key="DangerRedBgColor">#FEE2E2</Color>
    <Color x:Key="WarningAmberColor">#D97706</Color>
    <Color x:Key="WarningAmberBgColor">#FEF3C7</Color>
    <Color x:Key="InfoBlueColor">#0284C7</Color>
    <Color x:Key="InfoBlueBgColor">#E0F2FE</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryDeepBlueBrush" Color="{StaticResource PrimaryDeepBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBlueBrush" Color="{StaticResource PrimaryLightBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBlueBrush" Color="{StaticResource PrimaryDarkBlueColor}"/>
    <SolidColorBrush x:Key="BrandGoldBrush" Color="{StaticResource BrandGoldColor}"/>
    <SolidColorBrush x:Key="BrandGoldLightBrush" Color="{StaticResource BrandGoldLightColor}"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}"/>
    <SolidColorBrush x:Key="SuccessGreenBgBrush" Color="{StaticResource SuccessGreenBgColor}"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}"/>
    <SolidColorBrush x:Key="DangerRedBgBrush" Color="{StaticResource DangerRedBgColor}"/>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}"/>
    <SolidColorBrush x:Key="WarningAmberBgBrush" Color="{StaticResource WarningAmberBgColor}"/>
    <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}"/>
    <SolidColorBrush x:Key="InfoBlueBgBrush" Color="{StaticResource InfoBlueBgColor}"/>

    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="GridRowAlternateBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="GridSelectedRowBrush" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="GridSelectedRowBorderBrush" Color="#6366F1"/>
</ResourceDictionary>

