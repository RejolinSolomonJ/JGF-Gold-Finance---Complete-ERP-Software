<UserControl x:Class="JGF.Desktop.Views.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Refresh -->
                <RowDefinition Height="Auto"/> <!-- Top KPI Grid -->
                <RowDefinition Height="Auto"/> <!-- Middle Section: Charts & Upcoming Dues -->
                <RowDefinition Height="Auto"/> <!-- Quick Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header & Live Status -->
            <Border Grid.Row="0" Margin="0,0,0,16">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="📊 JGF EXECUTIVE DASHBOARD" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text=" | வணிக கட்டுப்பாட்டு மையம்" FontSize="14" Foreground="#64748B" Margin="8,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock x:Name="TxtLastRefreshed" Text="Updated: Just now" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="🔄 Refresh Data" Background="#1E3A8A" Foreground="White" FontWeight="Bold" Padding="12,6" Click="OnRefreshClick"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. KPI Cards Grid (3 Columns x 3 Rows) -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card 1: Today Cash Balance -->
                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TODAY CASH ON HAND (கையிருப்பு)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTodayCash" Text="₹ 0.00" FontSize="22" FontWeight="Bold" Foreground="#047857" Margin="0,6,0,4"/>
                        <TextBlock Text="Ledger Head 1001 Cash Balance" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Today Disbursements -->
                <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LOANS ISSUED TODAY (இன்றைய கடன்)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtLoansToday" Text="₹ 0.00" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtLoansTodayCount" Text="0 loans disbursed today" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Today Collections -->
                <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TODAY COLLECTIONS (இன்றைய வசூல்)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtCollectionsToday" Text="₹ 0.00" FontSize="22" FontWeight="Bold" Foreground="#B45309" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtCollectionsTodayBreakdown" Text="Pri: ₹0 | Int: ₹0" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Total Active Principal Outstanding -->
                <Border Grid.Row="0" Grid.Column="3" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ACTIVE OUTSTANDING (மொத்த நிலுவை)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalOutstanding" Text="₹ 0.00" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtActiveLoansCount" Text="0 active loan accounts" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Card 5: Gold Stock in Hand -->
                <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="GOLD STOCK IN CUSTODY (தங்க இருப்பு)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalGoldStock" Text="0.000 g" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtGoldStockSplit" Text="Locker: 0.000 g | Bank: 0.000 g" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Card 6: This Month Disbursements -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH DISBURSED (மாத கடன்)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtLoansMonth" Text="₹ 0.00" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtLoansMonthCount" Text="0 loans issued this month" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Card 7: Overdue Risk -->
                <Border Grid.Row="1" Grid.Column="2" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="OVERDUE LOANS (தவணை தவறியவை)" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock x:Name="TxtOverdueLoans" Text="₹ 0.00" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtOverdueCount" Text="0 accounts expired" FontSize="11" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>

                <!-- Card 8: Bank Repledge Exposure & Backup -->
                <Border Grid.Row="1" Grid.Column="3" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="BANK REPLEDGE EXPOSURE &amp; BACKUP" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock x:Name="TxtBankExposure" Text="₹ 0.00" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtBackupStatus" Text="Backup: Up to date" FontSize="11" Foreground="#059669"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Middle Section: Monthly Trends Chart & Bank Repledge Due Dates -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: 6-Month Business Trends -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="📈 6-MONTH BUSINESS TRENDS (மாதாந்திர வணிக வளர்ச்சி)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Border Width="10" Height="10" Background="#2563EB" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="Disbursed" FontSize="11" Margin="0,0,10,0"/>
                                    <Border Width="10" Height="10" Background="#059669" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="Collections" FontSize="11" Margin="0,0,10,0"/>
                                    <Border Width="10" Height="10" Background="#D97706" CornerRadius="2" Margin="0,0,4,0"/>
                                    <TextBlock Text="Interest" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="GridMonthlyTrends" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E2E8F0" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding MonthLabel}" FontWeight="SemiBold" Width="100"/>
                                <DataGridTextColumn Header="Disbursed (₹)" Binding="{Binding LoansDisbursedAmount, StringFormat={}{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="Total Collections (₹)" Binding="{Binding CollectionsAmount, StringFormat={}{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="Interest Income (₹)" Binding="{Binding InterestIncomeAmount, StringFormat={}{0:N2}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right: Bank Repledge Upcoming Dues & Warnings -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🏦 BANK REPLEDGE UPCOMING DUES (அடுத்த 30 நாட்கள் தவணைகள்)" FontWeight="Bold" FontSize="13" Foreground="#DC2626" Margin="0,0,0,12"/>
                        <DataGrid x:Name="GridUpcomingDues" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E2E8F0" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Repledge #" Binding="{Binding RepledgeNumber}" Width="100"/>
                                <DataGridTextColumn Header="Bank" Binding="{Binding BankName}" Width="*"/>
                                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="95"/>
                                <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="95"/>
                                <DataGridTextColumn Header="Days Left" Binding="{Binding DaysRemaining}" FontWeight="Bold" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Quick Operational Shortcuts Bar -->
            <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="12" Margin="4">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="⚡ FAST OPERATIONS:" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <WrapPanel>
                        <Button Content="➕ New Loan Entry (F2)" Background="#334155" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Padding="10,6" Click="OnNewLoanClick"/>
                        <Button Content="🧾 Receipt Payment (F4)" Background="#334155" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Padding="10,6" Click="OnReceiptClick"/>
                        <Button Content="🏦 Bank Repledge (F5)" Background="#334155" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Padding="10,6" Click="OnRepledgeClick"/>
                        <Button Content="⚠ Notices &amp; Auction (F6)" Background="#334155" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Padding="10,6" Click="OnNoticesClick"/>
                        <Button Content="📊 JL Reports (F7)" Background="#334155" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Padding="10,6" Click="OnReportsClick"/>
                        <Button Content="📖 Day Book &amp; Accounts (F9)" Background="#334155" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Padding="10,6" Click="OnDayBookClick"/>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
