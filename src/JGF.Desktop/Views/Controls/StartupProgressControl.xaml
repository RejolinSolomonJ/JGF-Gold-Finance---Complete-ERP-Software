<UserControl x:Class="JGF.Desktop.Views.Controls.StartupProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" 
                Padding="32" Width="440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1" Color="#000000"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="✦ JGF JEWEL LOAN FINANCE ✦" FontSize="18" FontWeight="Bold" Foreground="#DAA520" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Pawn &amp; Gold Loan Management System" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <ProgressBar IsIndeterminate="True" Height="6" Width="360" Background="#E2E8F0" Foreground="#1E3A8A" Margin="0,0,0,16"/>

                <TextBlock x:Name="TxtStatusMessage" Text="Connecting to PostgreSQL database..." FontSize="13" Foreground="#334155" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
