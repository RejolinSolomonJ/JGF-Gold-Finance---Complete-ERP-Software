<UserControl x:Class="JGF.Desktop.Views.Controls.DbConnectionSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16" MaxWidth="600" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="DATABASE CONNECTION CONFIGURATION" FontWeight="Bold" FontSize="16" Foreground="#B8860B"/>
            <TextBlock Text="Configure connection for PC1 (Server + App) or PC2 (Client on LAN)" Foreground="#777777" Margin="0,2,0,12"/>
            <Separator Margin="0,0,0,12"/>

            <!-- Mode selector -->
            <TextBlock Text="Workstation Mode:"/>
            <ComboBox x:Name="CmbMode" Margin="0,4,0,12" SelectedIndex="0" SelectionChanged="OnModeChanged">
                <ComboBoxItem Content="PC1 — Local Database Server (localhost)"/>
                <ComboBoxItem Content="PC2 — Remote Client over LAN"/>
            </ComboBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="PostgreSQL Host / IP:"/>
                    <TextBox x:Name="TxtHost" Text="localhost"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Port:"/>
                    <TextBox x:Name="TxtPort" Text="5432"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Database Name:" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtDatabase" Text="jgf_db"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Username:"/>
                    <TextBox x:Name="TxtUsername" Text="postgres"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Password:"/>
                    <PasswordBox x:Name="TxtPassword" Password="postgres" Height="28"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="SSL Mode:" Margin="0,8,0,0"/>
            <ComboBox x:Name="CmbSslMode" SelectedIndex="1" Margin="0,4,0,12">
                <ComboBoxItem Content="Disable"/>
                <ComboBoxItem Content="Prefer"/>
                <ComboBoxItem Content="Require"/>
            </ComboBox>

            <!-- Test Result Feedback -->
            <Border x:Name="BorderTestResult" Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="TxtTestResult" Text="Connection test passed!" Foreground="#2E7D32" FontWeight="SemiBold"/>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="⚡ Test Connection" Background="#1565C0" FontWeight="Bold" Width="140" Height="36" Click="OnTestConnectionClick"/>
                <Button Content="💾 Save Settings" Background="#2E7D32" FontWeight="Bold" Width="130" Height="36" Click="OnSaveConnectionClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

