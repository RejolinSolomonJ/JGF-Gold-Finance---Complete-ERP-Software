<UserControl x:Class="JGF.Desktop.Views.Controls.LoanReceiptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Search Bar -->
            <RowDefinition Height="Auto"/> <!-- Loan Info Snapshot Card -->
            <RowDefinition Height="*"/>    <!-- Interest Breakdown Table -->
            <RowDefinition Height="Auto"/> <!-- Payment Collection Form -->
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Find Loan (GL Number / Mobile / Barcode):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtSearchQuery" Width="240" VerticalContentAlignment="Center" Text="S1/24-25/0001"/>
                    <Button Content="🔍 Load Loan" Margin="8,0,0,0" Background="#B8860B" FontWeight="Bold" Width="110" Click="OnSearchLoanClick"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Receipt Date:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpReceiptDate" SelectedDateChanged="OnReceiptDateChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loan Summary Card -->
        <Border Grid.Row="1" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customer:" Foreground="#666666"/>
                    <TextBlock x:Name="TxtCustomerName" Text="-" FontWeight="Bold" FontSize="15"/>
                    <TextBlock x:Name="TxtCustomerMobile" Text="-" Foreground="#777777"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Loan Number &amp; Scheme:" Foreground="#666666"/>
                    <TextBlock x:Name="TxtLoanNo" Text="-" FontWeight="Bold" FontSize="15" Foreground="#B8860B"/>
                    <TextBlock x:Name="TxtSchemeInfo" Text="-" Foreground="#777777"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Pledged / Last Paid:" Foreground="#666666"/>
                    <TextBlock x:Name="TxtPledgeDate" Text="-" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtLastPaid" Text="Last: -" Foreground="#777777"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Principal Balance:" Foreground="#666666"/>
                    <TextBlock x:Name="TxtPrincipalBalance" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="#C62828"/>
                    <TextBlock x:Name="TxtNetWeight" Text="Net Wt: 0.000 g" Foreground="#777777"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Interest Table -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Background="#F0F0F0" Padding="8,4">
                    <TextBlock Text="Month-by-Month Interest Calculation Breakdown" FontWeight="Bold"/>
                </DockPanel>
                <DataGrid x:Name="GridInterest" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="From Date" Binding="{Binding FromDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="To Date" Binding="{Binding ToDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="100"/>
                        <DataGridTextColumn Header="Principal (₹)" Binding="{Binding Principal, StringFormat={}{0:N2}}" Width="110"/>
                        <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="60"/>
                        <DataGridTextColumn Header="Months" Binding="{Binding Months, StringFormat={}{0:F2}}" Width="70"/>
                        <DataGridTextColumn Header="Rate/Mo" Binding="{Binding MonthlyRate, StringFormat={}{0:F2}%}" Width="80"/>
                        <DataGridTextColumn Header="Interest Amount (₹)" Binding="{Binding InterestAmount, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Payment Form -->
        <Border Grid.Row="3" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Receive As Selector -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="Receive Type:"/>
                    <ComboBox x:Name="CmbReceiptType" SelectedIndex="0" SelectionChanged="OnReceiptTypeChanged">
                        <ComboBoxItem Content="Interest Only"/>
                        <ComboBoxItem Content="Part Payment (Interest + Principal)"/>
                        <ComboBoxItem Content="Full Closure"/>
                    </ComboBox>
                </StackPanel>

                <!-- Interest Payable -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,8,6">
                    <TextBlock Text="Accrued Interest (₹):"/>
                    <TextBox x:Name="TxtInterestAmount" Text="0.00" TextChanged="OnPaymentAmountChanged"/>
                </StackPanel>

                <!-- Part Principal -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,8,6">
                    <TextBlock Text="Part Principal Paid (₹):"/>
                    <TextBox x:Name="TxtPartPrincipal" Text="0.00" TextChanged="OnPaymentAmountChanged"/>
                </StackPanel>

                <!-- Other / Postal Charges -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Postal Charges / Notice Fee (₹):"/>
                    <TextBox x:Name="TxtPostalCharges" Text="0.00" TextChanged="OnPaymentAmountChanged"/>
                </StackPanel>

                <!-- Adjustment / Discount -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,0">
                    <TextBlock Text="Round-Off / Adjustment (₹):"/>
                    <TextBox x:Name="TxtAdjustment" Text="0.00" TextChanged="OnPaymentAmountChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,8,0">
                    <TextBlock Text="Payment Mode:"/>
                    <ComboBox x:Name="CmbPayMode" SelectedIndex="0">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="UPI / GPay / PhonePe"/>
                        <ComboBoxItem Content="Bank Transfer"/>
                        <ComboBoxItem Content="Cheque"/>
                    </ComboBox>
                </StackPanel>

                <!-- Total Amount Card -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,4,8,0" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL RECEIVABLE:" FontWeight="Bold" Foreground="#666666"/>
                    <TextBlock x:Name="TxtTotalReceivable" Text="₹ 0.00" FontWeight="Bold" FontSize="20" Foreground="#2E7D32"/>
                </StackPanel>

                <!-- Save Button -->
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,4,0,0" VerticalAlignment="Bottom">
                    <Button Content="💾 Process Receipt &amp; Print (F10)" Height="38" Background="#2E7D32" FontWeight="Bold" Click="OnProcessReceiptClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

