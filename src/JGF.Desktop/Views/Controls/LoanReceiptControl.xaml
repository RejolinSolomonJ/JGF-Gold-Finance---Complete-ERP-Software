<UserControl x:Class="JGF.Desktop.Views.Controls.LoanReceiptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Search Bar Card -->
            <RowDefinition Height="Auto"/> <!-- Loan Info Snapshot Card -->
            <RowDefinition Height="*"/>    <!-- Interest Breakdown Table -->
            <RowDefinition Height="Auto"/> <!-- Payment Collection Form Card -->
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Find Loan (GL Number / Customer Mobile):" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtSearchQuery" Width="260" Text="S1/24-25/0001" KeyDown="OnSearchKeyDown" TabIndex="0"/>
                    <Button Content="🔍 Load Loan" Margin="10,0,0,0" Width="130" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnSearchLoanClick" TabIndex="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Receipt Date:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpReceiptDate" Width="130" SelectedDateChanged="OnReceiptDateChanged" TabIndex="2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loan Summary Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Customer:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtCustomerName" Text="-" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtCustomerMobile" Text="-" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Loan Number &amp; Scheme:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtLoanNo" Text="-" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandGoldBrush}"/>
                    <TextBlock x:Name="TxtSchemeInfo" Text="-" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Pledged / Last Paid:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtPledgeDate" Text="-" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="TxtLastPaid" Text="Last: -" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Principal Balance:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtPrincipalBalance" Text="₹ 0.00" FontWeight="Bold" FontSize="20" Foreground="{StaticResource DangerRedBrush}"/>
                    <TextBlock x:Name="TxtNetWeight" Text="Net Wt: 0.000 g" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Interest Table -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Month-by-Month Interest Calculation Breakdown" FontWeight="Bold" FontSize="14"/>
                </Border>
                <DataGrid x:Name="GridInterest" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="From Date" Binding="{Binding FromDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="To Date" Binding="{Binding ToDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Principal (₹)" Binding="{Binding Principal, StringFormat={}{0:N2}}" Width="120"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="70"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Months" Binding="{Binding Months, StringFormat={}{0:F2}}" Width="80"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Rate/Mo" Binding="{Binding MonthlyRate, StringFormat={}{0:F2}%}" Width="85"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Interest Amount (₹)" Binding="{Binding InterestAmount, StringFormat={}{0:N2}}" Width="140" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Description / Slab" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Payment Collection Form -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Receive As Selector -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                    <TextBlock Text="Receipt Type:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbReceiptType" SelectedIndex="0" SelectionChanged="OnReceiptTypeChanged" TabIndex="3">
                        <ComboBoxItem Content="Interest Only"/>
                        <ComboBoxItem Content="Part Payment (Interest + Principal)"/>
                        <ComboBoxItem Content="Full Closure &amp; Release"/>
                    </ComboBox>
                </StackPanel>

                <!-- Interest Payable -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,10,6">
                    <TextBlock Text="Accrued Interest (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtInterestAmount" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="4"/>
                    <TextBlock x:Name="TxtInterestError" Text="Interest cannot be negative." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Part Principal -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,10,6">
                    <TextBlock Text="Part Principal Paid (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPartPrincipal" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="5"/>
                    <TextBlock x:Name="TxtPrincipalError" Text="Invalid principal amount." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Other / Postal Charges -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Postal Charges / Notice Fee (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPostalCharges" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="6"/>
                    <TextBlock x:Name="TxtPostalError" Text="Charges cannot be negative." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Adjustment / Discount -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,10,0">
                    <TextBlock Text="Round-Off / Adjustment (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtAdjustment" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="7"/>
                    <TextBlock x:Name="TxtAdjustmentError" Text="Adjustment cannot be negative." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,6,10,0">
                    <TextBlock Text="Payment Mode:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbPayMode" SelectedIndex="0" TabIndex="8">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="UPI / GPay / PhonePe"/>
                        <ComboBoxItem Content="Bank Transfer"/>
                        <ComboBoxItem Content="Cheque"/>
                    </ComboBox>
                </StackPanel>

                <!-- Total Amount Card -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,6,10,0" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL RECEIVABLE:" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalReceivable" Text="₹ 0.00" FontWeight="Bold" FontSize="22" Foreground="{StaticResource SuccessGreenBrush}"/>
                </StackPanel>

                <!-- Process Button & Actions -->
                <Grid Grid.Row="1" Grid.Column="3" Margin="4,6,0,0" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" x:Name="BtnProcessReceipt" Content="Process Receipt &amp; Print" Height="36" Style="{StaticResource SuccessButtonStyle}" Click="OnProcessReceiptClick" TabIndex="9"/>
                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button x:Name="BtnDirectPrint" Content="🖨️ Direct Print" Width="98" Height="30" FontSize="11" Style="{StaticResource SecondaryButtonStyle}" Click="OnDirectPrintClick" IsEnabled="False" ToolTip="Send latest receipt directly to printer"/>
                        <Button x:Name="BtnDownloadPdf" Content="💾 Download PDF" Width="105" Height="30" Margin="4,0,0,0" FontSize="11" Style="{StaticResource SecondaryButtonStyle}" Click="OnDownloadPdfClick" IsEnabled="False" ToolTip="Download receipt as PDF"/>
                        <Button x:Name="BtnPastReceipts" Content="📜 Past Receipts" Height="30" Margin="4,0,0,0" FontSize="11" Style="{StaticResource SecondaryButtonStyle}" Click="OnPastReceiptsClick" IsEnabled="False" ToolTip="View previous receipts for this loan"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
