<UserControl x:Class="JGF.Desktop.Views.Controls.FinancialReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Report Switcher -->
            <RowDefinition Height="*"/>    <!-- Report View Area -->
        </Grid.RowDefinitions>

        <!-- Report Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Report:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbReportType" Width="180" SelectedIndex="0" SelectionChanged="OnReportTypeChanged" Margin="0,0,16,0">
                        <ComboBoxItem Content="Trial Balance (இருப்பாய்வு)"/>
                        <ComboBoxItem Content="Profit &amp; Loss (இலாப நட்டம்)"/>
                        <ComboBoxItem Content="Balance Sheet (இருப்புநிலை)"/>
                    </ComboBox>
                    <TextBlock Text="As of / Date Range:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpDate" Width="120" Margin="0,0,10,0"/>
                    <Button Content="Generate Report" Background="#2B2B2B" FontWeight="Bold" Width="130" Click="OnGenerateReportClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="📄 Export PDF / Print" Background="#1565C0" FontWeight="Bold" Width="150" Click="OnExportPdfClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dynamic Report Container -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12">
            <Grid>
                <!-- 1. Trial Balance Grid View -->
                <Grid x:Name="PanelTrialBalance" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridTrialBalance" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Particulars / Ledger Head" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Group" Binding="{Binding AccountGroup}" Width="120"/>
                            <DataGridTextColumn Header="Debit Balance (₹)" Binding="{Binding DebitBalance, StringFormat={}{0:N2}}" Width="140"/>
                            <DataGridTextColumn Header="Credit Balance (₹)" Binding="{Binding CreditBalance, StringFormat={}{0:N2}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="#F0F0F0" Padding="8,4">
                        <DockPanel>
                            <TextBlock Text="Total Trial Balance:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBlock Text="Total Dr: " FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTbTotalDr" Text="₹ 0.00" FontWeight="Bold" Margin="0,0,20,0"/>
                                <TextBlock Text="Total Cr: " FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTbTotalCr" Text="₹ 0.00" FontWeight="Bold" Margin="0,0,20,0"/>
                                <TextBlock x:Name="TxtTbDiff" Text="Difference: ₹ 0.00" FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 2. Profit and Loss View -->
                <Grid x:Name="PanelPnL" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: Expenses -->
                    <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="EXPENSES (செலவுகள்)" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridExpenses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                                    <DataGridTextColumn Header="Expense Head" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#FFF3E0" Padding="8,4">
                                <DockPanel>
                                    <TextBlock Text="Total Expenses:" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtTotalExpenses" Text="₹ 0.00" FontWeight="Bold" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Right: Incomes -->
                    <Border Grid.Column="1" Padding="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="INCOME (வருமானம்)" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridIncomes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                                    <DataGridTextColumn Header="Income Head" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#E8F5E9" Padding="8,4">
                                <DockPanel>
                                    <TextBlock x:Name="TxtNetProfitLabel" Text="Net Profit (நிகர இலாபம்):" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtNetProfitValue" Text="₹ 0.00" FontWeight="Bold" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Balance Sheet View -->
                <Grid x:Name="PanelBalanceSheet" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: Liabilities & Capital -->
                    <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="LIABILITIES &amp; CAPITAL (பொறுப்புகள் &amp; மூலதனம்)" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridLiabilities" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                                    <DataGridTextColumn Header="Liabilities / Capital" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#F0F0F0" Padding="8,4">
                                <DockPanel>
                                    <TextBlock Text="Total Liabilities &amp; Capital:" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtTotalLiabilities" Text="₹ 0.00" FontWeight="Bold" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Right: Assets -->
                    <Border Grid.Column="1" Padding="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ASSETS (சொத்துக்கள்)" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                            <DataGrid x:Name="GridAssets" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                                    <DataGridTextColumn Header="Asset Head" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#F0F0F0" Padding="8,4">
                                <DockPanel>
                                    <TextBlock Text="Total Assets:" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtTotalAssets" Text="₹ 0.00" FontWeight="Bold" DockPanel.Dock="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

