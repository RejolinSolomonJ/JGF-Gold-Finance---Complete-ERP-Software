<UserControl x:Class="JGF.Desktop.Views.Controls.ConnectionFailureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" 
                Padding="32" Width="520">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- Warning Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⚠" FontSize="32" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PostgreSQL Not Reachable" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="TxtEndpoint" Text="Host: localhost | Port: 5432" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Text="Cannot establish connection to the PostgreSQL database server. Please ensure that:" 
                           TextWrapping="Wrap" Foreground="#334155" FontSize="13" Margin="0,0,0,12"/>

                <StackPanel Margin="12,0,0,16">
                    <TextBlock Text="• PostgreSQL 18 service is running on this PC (or LAN PC1)." Foreground="#475569" FontSize="12" Margin="0,2"/>
                    <TextBlock Text="• Connection credentials (host, port, user, password) in Settings are correct." Foreground="#475569" FontSize="12" Margin="0,2"/>
                    <TextBlock Text="• Windows Firewall allows inbound connections on port 5432." Foreground="#475569" FontSize="12" Margin="0,2"/>
                </StackPanel>

                <!-- Error Detail Box -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                    <TextBlock x:Name="TxtErrorDetails" Text="Connection timed out." Foreground="#991B1B" FontSize="11" TextWrapping="Wrap" MaxHeight="80"/>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenSettings" Content="⚙ Open Settings" Width="140" Height="36" Background="#475569" Foreground="White" FontWeight="SemiBold" Click="OnOpenSettingsClick" Margin="0,0,12,0"/>
                    <Button x:Name="BtnRetry" Content="🔄 Retry Connection" Width="160" Height="36" Background="#1E3A8A" Foreground="White" FontWeight="Bold" Click="OnRetryClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
