<UserControl x:Class="JGF.Desktop.Views.Controls.BackupSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Backup Configuration & Triggers -->
        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,16,0">
            <StackPanel>
                <TextBlock Text="POSTGRESQL AES-256 BACKUP" FontWeight="Bold" FontSize="16" Foreground="#B8860B"/>
                <Separator Margin="0,8"/>

                <TextBlock Text="Encryption Master Key / Passphrase (* Owner Held):"/>
                <PasswordBox x:Name="TxtKey" Height="28" Margin="0,4"/>

                <TextBlock Text="PC2 LAN Shared Destination Folder:" Margin="0,8,0,0"/>
                <TextBox x:Name="TxtLanFolder" Text="\\PC2\JGF_Backups"/>

                <TextBlock Text="Cloud Sync Folder (OneDrive / GDrive):" Margin="0,8,0,0"/>
                <TextBox x:Name="TxtCloudFolder" Text="C:\Users\Rejolin Solomon J\OneDrive\JGF_Cloud_Backups"/>

                <TextBlock Text="Retention Policy:" Margin="0,8,0,0" FontWeight="SemiBold"/>
                <TextBlock Text="• 30 Daily Encrypted Dumps&#x0a;• 12 Monthly Archives" Foreground="#666666"/>

                <Button Content="▶ Run Encrypted Backup Now" Background="#B8860B" FontWeight="Bold" Margin="0,16,0,0" Height="36" Click="OnRunBackupClick"/>

                <Separator Margin="0,16"/>

                <TextBlock Text="RESTORE TO TEST DATABASE" FontWeight="Bold" FontSize="14" Foreground="#333333"/>
                <TextBlock Text="Verifies backup integrity without affecting production database." Foreground="#777777" TextWrapping="Wrap" Margin="0,4"/>

                <TextBlock Text="Select Encrypted Backup File:" Margin="0,8,0,0"/>
                <DockPanel>
                    <Button Content="Browse..." DockPanel.Dock="Right" Click="OnBrowseRestoreClick"/>
                    <TextBox x:Name="TxtRestoreFile" IsReadOnly="True"/>
                </DockPanel>

                <Button Content="🔄 Test Restore to 'jgf_test_db'" Background="#1565C0" FontWeight="Bold" Margin="0,12,0,0" Height="36" Click="OnTestRestoreClick"/>
            </StackPanel>
        </Border>

        <!-- Right: Backup Execution History Log -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="BACKUP EXECUTION LOGS" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
            <DataGrid x:Name="GridLogs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#CCCCCC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding BackupDate, StringFormat={}{0:dd-MMM-yyyy HH:mm}}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Size (MB)" Binding="{Binding FileSizeBytes, StringFormat={}{0:N2}}" Width="80"/>
                    <DataGridTextColumn Header="Destination File" Binding="{Binding FilePath}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
