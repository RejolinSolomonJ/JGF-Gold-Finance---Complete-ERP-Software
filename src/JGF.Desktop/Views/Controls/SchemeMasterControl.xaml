<UserControl x:Class="JGF.Desktop.Views.Controls.SchemeMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="+ New Scheme" DockPanel.Dock="Right" Background="#B8860B" Click="OnNewSchemeClick"/>
                    <TextBlock Text="LOAN SCHEMES" FontWeight="Bold" FontSize="16" Foreground="#B8860B"/>
                </DockPanel>
                <DataGrid x:Name="GridSchemes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="OnSchemeSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="60"/>
                        <DataGridTextColumn Header="Scheme Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Rate/Mo" Binding="{Binding InterestRate, StringFormat={}{0:N2}%}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="16,0,0,0">
            <StackPanel>
                <TextBlock Text="Scheme Configuration" FontWeight="Bold" FontSize="16"/>
                <Separator Margin="0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Scheme Code:"/>
                        <TextBox x:Name="TxtSchemeCode" Text="S1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Scheme Name:"/>
                        <TextBox x:Name="TxtSchemeName" Text="Standard Gold Loan"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Monthly Interest Rate (%):"/>
                        <TextBox x:Name="TxtInterestRate" Text="1.50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Monthly Penal Rate (%):"/>
                        <TextBox x:Name="TxtPenalRate" Text="0.50"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Max LTV (%):"/>
                        <TextBox x:Name="TxtMaxLtv" Text="75.00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Tenure (Months):"/>
                        <TextBox x:Name="TxtTenureMonths" Text="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="Grace Days:"/>
                        <TextBox x:Name="TxtGraceDays" Text="7"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Soft Delete" Background="#C62828" Click="OnDeleteSchemeClick" Width="100"/>
                    <Button Content="Save Scheme" Background="#2E7D32" FontWeight="Bold" Click="OnSaveSchemeClick" Width="140"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
