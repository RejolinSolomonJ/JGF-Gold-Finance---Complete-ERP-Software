<UserControl x:Class="JGF.Desktop.Views.Controls.CustomerMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/> <!-- Left: Search & List Card -->
            <ColumnDefinition Width="*"/>   <!-- Right: Customer KYC & Edit Form Card -->
        </Grid.ColumnDefinitions>

        <!-- Left List Panel -->
        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,12,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CUSTOMERS / வாடிக்கையாளர்கள்" Style="{StaticResource SubheadingTextStyle}" Foreground="{StaticResource PrimaryDeepBlueBrush}"/>

                <DockPanel Grid.Row="1" Margin="0,10,0,8">
                    <Button x:Name="BtnNewCustomer" Content="+ New Customer" DockPanel.Dock="Right" Width="130" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnNewCustomerClick" TabIndex="1"/>
                    <TextBox x:Name="TxtSearch" TextChanged="OnSearchTextChanged" ToolTip="Search by Name, Code, Mobile, Aadhaar..." Height="36" Margin="0,0,8,0" TabIndex="0"/>
                </DockPanel>
                <ProgressBar x:Name="PrgLoading" Grid.Row="1" VerticalAlignment="Bottom" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>

                <DataGrid x:Name="GridCustomers" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="OnCustomerSelected" TabIndex="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="160"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding MobileNumber}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right Detail / Form Panel -->
        <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <StackPanel>
                    <TextBlock Text="Customer Profile &amp; KYC (வாடிக்கையாளர் விவரங்கள்)" Style="{StaticResource SubheadingTextStyle}"/>
                    <Separator Margin="0,10,0,14" Background="{StaticResource BorderLightBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/> <!-- Photo area -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,6">
                                    <TextBlock Text="Customer Code:" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtCode" IsReadOnly="True" Background="{StaticResource SurfaceAltBrush}" TabIndex="3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,6">
                                    <TextBlock Text="Mobile Number (* 10 Digits):" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMobile" MaxLength="10" TextChanged="OnMobileTextChanged" TabIndex="4"/>
                                    <TextBlock x:Name="TxtMobileError" Text="Enter a valid 10-digit mobile number." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Full Name (English) (*):" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                            <TextBox x:Name="TxtFullName" TextChanged="OnFullNameTextChanged" TabIndex="5"/>
                            <TextBlock x:Name="TxtNameError" Text="Full name is required." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>

                            <TextBlock Text="பெயர் (Tamil):" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                            <TextBox x:Name="TxtNameTamil" TabIndex="6"/>

                            <TextBlock Text="Father / Husband Name:" Style="{StaticResource FieldLabelStyle}" Margin="0,6,0,0"/>
                            <TextBox x:Name="TxtGuardian" TabIndex="7"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Aadhaar Number (12 Digits):" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtAadhaar" MaxLength="12" TextChanged="OnAadhaarTextChanged" TabIndex="8"/>
                                    <TextBlock x:Name="TxtAadhaarError" Text="Aadhaar must be 12 digits." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="PAN Number (10 Chars):" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPan" MaxLength="10" CharacterCasing="Upper" TextChanged="OnPanTextChanged" TabIndex="9"/>
                                    <TextBlock x:Name="TxtPanError" Text="Invalid PAN (e.g. ABCDE1234F)." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Photo & Webcam Capture Panel -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Margin="16,0,0,0" Padding="10" Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="150" Height="150" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" CornerRadius="4">
                                    <Image x:Name="ImgCustomerPhoto" Stretch="UniformToFill"/>
                                </Border>
                                <Button Content="📷 Attach Photo" Margin="0,10,0,0" Width="150" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnCapturePhotoClick" TabIndex="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Address:" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                    <TextBox x:Name="TxtAddress" Height="58" TextWrapping="Wrap" AcceptsReturn="True" TabIndex="11"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="City / Town:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtCity" Text="Chennai" TabIndex="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                            <TextBlock Text="District:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtDistrict" Text="Chennai" TabIndex="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="Pincode (6 Digits):" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtPincode" MaxLength="6" TextChanged="OnPincodeTextChanged" TabIndex="14"/>
                            <TextBlock x:Name="TxtPincodeError" Text="Pincode must be 6 digits." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <DockPanel Margin="0,24,0,0">
                        <Button x:Name="BtnDeleteCustomer" Content="Soft Delete" Width="110" Height="36" Style="{StaticResource DangerButtonStyle}" Click="OnDeleteCustomerClick" Visibility="Collapsed" TabIndex="15"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear Form" Width="110" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnNewCustomerClick" Margin="0,0,10,0" TabIndex="16"/>
                            <Button x:Name="BtnSaveCustomer" Content="Save Customer" Width="160" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveCustomerClick" TabIndex="17"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
