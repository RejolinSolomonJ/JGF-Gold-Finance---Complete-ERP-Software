<UserControl x:Class="JGF.Desktop.Views.Controls.CustomerMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/> <!-- Left: Search & List -->
            <ColumnDefinition Width="*"/>   <!-- Right: Customer Edit Form -->
        </Grid.ColumnDefinitions>

        <!-- Left List Panel -->
        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CUSTOMERS / வாடிக்கையாளர்கள்" FontWeight="Bold" FontSize="16" Foreground="#B8860B"/>

                <DockPanel Grid.Row="1" Margin="0,8">
                    <Button Content="+ New Customer" DockPanel.Dock="Right" Background="#B8860B" Click="OnNewCustomerClick"/>
                    <TextBox x:Name="TxtSearch" TextChanged="OnSearchTextChanged" ToolTip="Search by Name, Code, Mobile, Aadhaar..."/>
                </DockPanel>

                <DataGrid x:Name="GridCustomers" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="OnCustomerSelected" BorderBrush="#CCCCCC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="150"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding MobileNumber}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right Detail / Form Panel -->
        <ScrollViewer Grid.Column="1" Padding="16,0,0,0">
            <StackPanel>
                <TextBlock Text="Customer Profile &amp; KYC" FontWeight="Bold" FontSize="16" Foreground="#333333"/>
                <Separator Margin="0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/> <!-- Photo area -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Customer Code:"/>
                                <TextBox x:Name="TxtCode" IsReadOnly="True" Background="#F0F0F0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Mobile Number (*):"/>
                                <TextBox x:Name="TxtMobile"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Full Name (English) (*):" Margin="0,8,0,0"/>
                        <TextBox x:Name="TxtFullName"/>

                        <TextBlock Text="பெயர் (Tamil):" Margin="0,8,0,0"/>
                        <TextBox x:Name="TxtNameTamil"/>

                        <TextBlock Text="Father / Husband Name:" Margin="0,8,0,0"/>
                        <TextBox x:Name="TxtGuardian"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Aadhaar Number:"/>
                                <TextBox x:Name="TxtAadhaar" MaxLength="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="PAN Number:"/>
                                <TextBox x:Name="TxtPan" MaxLength="10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Photo & Webcam Capture Panel -->
                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="12,0,0,0" Padding="8">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="140" Height="140" Background="#EEEEEE" BorderBrush="#DDDDDD" BorderThickness="1">
                                <Image x:Name="ImgCustomerPhoto" Stretch="UniformToFill"/>
                            </Border>
                            <Button Content="📷 Capture / Upload" Margin="0,8,0,0" Click="OnCapturePhotoClick" Width="140"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Address:" Margin="0,8,0,0"/>
                <TextBox x:Name="TxtAddress" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="City / Town:"/>
                        <TextBox x:Name="TxtCity" Text="Chennai"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="District:"/>
                        <TextBox x:Name="TxtDistrict" Text="Chennai"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="Pincode:"/>
                        <TextBox x:Name="TxtPincode"/>
                    </StackPanel>
                </Grid>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Soft Delete" Background="#C62828" Click="OnDeleteCustomerClick" Width="100"/>
                    <Button Content="Save Customer (F10)" Background="#2E7D32" FontWeight="Bold" Click="OnSaveCustomerClick" Width="160"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
