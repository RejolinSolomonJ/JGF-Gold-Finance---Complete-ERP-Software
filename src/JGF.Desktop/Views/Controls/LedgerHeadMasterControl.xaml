<UserControl x:Class="JGF.Desktop.Views.Controls.LedgerHeadMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="+ New Head" DockPanel.Dock="Right" Background="#B8860B" Click="OnNewHeadClick"/>
                    <TextBlock Text="CHART OF ACCOUNTS" FontWeight="Bold" FontSize="16" Foreground="#B8860B"/>
                </DockPanel>
                <DataGrid x:Name="GridHeads" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="OnHeadSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="60"/>
                        <DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="160"/>
                        <DataGridTextColumn Header="Group" Binding="{Binding AccountGroup}" Width="90"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding NormalBalance}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Ledger Account Details" FontWeight="Bold" FontSize="16"/>
            <Separator Margin="0,8"/>

            <TextBlock Text="Account Code:"/>
            <TextBox x:Name="TxtCode" Text="1006"/>

            <TextBlock Text="Account Name / கணக்கின் பெயர்:" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtName" Text="Postage &amp; Courier Account"/>

            <TextBlock Text="Account Group / பிரிவு:" Margin="0,8,0,0"/>
            <ComboBox x:Name="CmbGroup" Margin="0,4" SelectedIndex="3">
                <ComboBoxItem Content="Asset"/>
                <ComboBoxItem Content="Liability"/>
                <ComboBoxItem Content="Capital"/>
                <ComboBoxItem Content="Income"/>
                <ComboBoxItem Content="Expense"/>
            </ComboBox>

            <TextBlock Text="Normal Balance:" Margin="0,8,0,0"/>
            <ComboBox x:Name="CmbBalance" Margin="0,4" SelectedIndex="0">
                <ComboBoxItem Content="Debit"/>
                <ComboBoxItem Content="Credit"/>
            </ComboBox>

            <TextBlock Text="Description:" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtDesc" Height="60" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Soft Delete" Background="#C62828" Click="OnDeleteHeadClick" Width="100"/>
                <Button Content="Save Ledger Head" Background="#2E7D32" FontWeight="Bold" Click="OnSaveHeadClick" Width="150"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

