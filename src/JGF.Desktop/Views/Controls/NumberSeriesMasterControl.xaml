<UserControl x:Class="JGF.Desktop.Views.Controls.NumberSeriesMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NUMBER SERIES CONFIGURATION (GAPLESS SEQUENCE)" FontWeight="Bold" FontSize="16" Foreground="#B8860B" Margin="0,0,0,12"/>

        <DataGrid x:Name="GridSeries" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" BorderBrush="#CCCCCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Series Type" Binding="{Binding SeriesType}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="90"/>
                <DataGridTextColumn Header="Financial Year" Binding="{Binding FinancialYear}" Width="110"/>
                <DataGridTextColumn Header="Last Number" Binding="{Binding LastNumber}" Width="100"/>
                <DataGridTextColumn Header="Pad Length" Binding="{Binding PadLength}" Width="90"/>
                <DataGridTextColumn Header="Separator" Binding="{Binding Separator}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save Number Series" Background="#2E7D32" FontWeight="Bold" Click="OnSaveClick" Width="180"/>
        </StackPanel>
    </Grid>
</UserControl>

