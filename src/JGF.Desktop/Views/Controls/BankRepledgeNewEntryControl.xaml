<UserControl x:Class="JGF.Desktop.Views.Controls.BankRepledgeNewEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Bank Selection & Terms Header -->
            <RowDefinition Height="*"/>    <!-- Collateral Customer Loans Selection Grid -->
            <RowDefinition Height="Auto"/> <!-- Summary & Save Button -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="✦ NEW BANK RE-PLEDGE ENTRY (வங்கி மறு அடமானம் பதிவு)" FontWeight="Bold" FontSize="16" Foreground="#B8860B" Margin="0,0,0,10"/>

        <!-- Bank Header Info Form -->
        <Border Grid.Row="1" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="Bank / NBFC (*):"/>
                    <ComboBox x:Name="CmbBank" SelectionChanged="OnBankChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,8,6">
                    <TextBlock Text="Bank Pledge No / Pawn No (*):"/>
                    <TextBox x:Name="TxtPledgeNumber" Text="BP-SBI-001"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,8,6">
                    <TextBlock Text="Pledging Date:"/>
                    <DatePicker x:Name="DpPledgeDate"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Maturity / Due Date:"/>
                    <DatePicker x:Name="DpMaturityDate"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,0">
                    <TextBlock Text="Bank Interest Rate (%/month):"/>
                    <TextBox x:Name="TxtInterestRate" Text="0.75"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,8,0">
                    <TextBlock Text="Bank Appraised Weight (grams):"/>
                    <TextBox x:Name="TxtBankWeight" Text="0.000"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,4,8,0">
                    <TextBlock Text="Bank Loan A/C No:"/>
                    <TextBox x:Name="TxtBankAccountNo" Text="SBIN-GL-98765"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,4,0,0">
                    <TextBlock Text="Account Holder Name:"/>
                    <TextBox x:Name="TxtAccountHolder" Text="JGF Bankers"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Customer Loans Selection Grid -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F0F0F0" Padding="8,6">
                    <DockPanel>
                        <TextBlock Text="Select Customer Loans to Repledge to Bank (வாடிக்கையாளர் கடன்களை தேர்வு செய்க)" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Select All" DockPanel.Dock="Right" Background="#333333" Width="90" Click="OnSelectAllLoansClick"/>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="GridAvailableLoans" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" BorderBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pledge" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="GL Loan No" Binding="{Binding LoanNumber}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Pledge Date" Binding="{Binding PledgeDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Net Wt (g)" Binding="{Binding NetWeight, StringFormat={}{0:F3}}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customer Loan (₹)" Binding="{Binding LoanAmount, StringFormat={}{0:N2}}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Packet No" Binding="{Binding PacketNumber}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary & Actions -->
        <Border Grid.Row="3" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Selected Customer Loans:" Foreground="#666666"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0 loans selected" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Total Customer Principal:" Foreground="#666666" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtSelectedPrincipal" Text="₹ 0.00" FontWeight="Bold" FontSize="15"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total Net Gold Weight:" Foreground="#666666"/>
                    <TextBlock x:Name="TxtSelectedWeight" Text="0.000 g" FontWeight="Bold" FontSize="15" Foreground="#B8860B"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Bank Disbursed Amount (₹) (* Cash Inflow):" FontWeight="Bold"/>
                    <TextBox x:Name="TxtBankDisbursedAmount" Height="32" FontSize="16" FontWeight="Bold" Text="0.00"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="💾 Save Bank Pledge &amp; Post Voucher (F10)" Height="38" Background="#B8860B" FontWeight="Bold" Padding="16,0" Click="OnSaveBankPledgeClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
