<UserControl x:Class="JGF.Desktop.Views.Controls.BankRepledgeNewEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Bank Selection & Terms Header Card -->
            <RowDefinition Height="*"/>    <!-- Collateral Customer Loans Selection Grid Card -->
            <RowDefinition Height="Auto"/> <!-- Summary & Save Button Card -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="✦ NEW BANK RE-PLEDGE ENTRY (வங்கி மறு அடமானம் பதிவு)" Style="{StaticResource HeadingTextStyle}" Foreground="{StaticResource PrimaryDeepBlueBrush}" Margin="0,0,0,12"/>

        <!-- Bank Header Info Form -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                    <TextBlock Text="Bank / NBFC (*):" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbBank" SelectionChanged="OnBankChanged" TabIndex="0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,10,6">
                    <TextBlock Text="Bank Pledge / Pawn No (*):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPledgeNumber" Text="BP-SBI-001" TabIndex="1"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,10,6">
                    <TextBlock Text="Pledging Date:" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DpPledgeDate" TabIndex="2"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Maturity / Due Date:" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DpMaturityDate" TabIndex="3"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,10,0">
                    <TextBlock Text="Bank Interest Rate (%/month):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtInterestRate" Text="0.75" TabIndex="4"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,6,10,0">
                    <TextBlock Text="Bank Appraised Weight (g):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtBankWeight" Text="0.000" TabIndex="5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,6,10,0">
                    <TextBlock Text="Bank Loan A/C No:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtBankAccountNo" Text="SBIN-GL-98765" TabIndex="6"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,6,0,0">
                    <TextBlock Text="Account Holder Name:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtAccountHolder" Text="JGF Bankers" TabIndex="7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Customer Loans Selection Grid -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Select Customer Loans to Repledge to Bank (Shop Locker Inventory)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="Select All / None" DockPanel.Dock="Right" Width="140" Height="32" Style="{StaticResource SecondaryButtonStyle}" Click="OnSelectAllLoansClick" TabIndex="8"/>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="GridAvailableLoans" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" TabIndex="9">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pledge" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTextColumn Header="GL Loan No" Binding="{Binding LoanNumber}" Width="130" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Pledge Date" Binding="{Binding PledgeDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110" IsReadOnly="True"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Net Wt (g)" Binding="{Binding NetWeight, StringFormat={}{0:F3}}" Width="100" IsReadOnly="True"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Customer Principal (₹)" Binding="{Binding LoanAmount, StringFormat={}{0:N2}}" Width="150" IsReadOnly="True" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Packet No" Binding="{Binding PacketNumber}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary & Actions -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Selected Customer Loans:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0 loans selected" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryDeepBlueBrush}"/>
                    <TextBlock Text="Total Customer Principal:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtSelectedPrincipal" Text="₹ 0.00" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total Net Gold Weight:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtSelectedWeight" Text="0.000 g" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandGoldBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Bank Disbursed Amount (₹) (* Cash Inflow):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtBankDisbursedAmount" Height="36" FontSize="16" FontWeight="Bold" Text="0.00" TabIndex="10"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="Save Bank Pledge &amp; Post Voucher" Height="36" Style="{StaticResource PrimaryButtonStyle}" Padding="16,0" Click="OnSaveBankPledgeClick" TabIndex="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
