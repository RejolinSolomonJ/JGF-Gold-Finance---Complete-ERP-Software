<UserControl x:Class="JGF.Desktop.Views.Controls.GoldRateMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Recent Gold Rates -->
        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DAILY GOLD RATES (30 DAYS)" FontWeight="Bold" FontSize="16" Foreground="#B8860B" Margin="0,0,0,8"/>
                <DataGrid x:Name="GridRates" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/>
                        <DataGridTextColumn Header="22K Rate (₹/g)" Binding="{Binding Rate22K, StringFormat={}{0:N2}}" Width="120"/>
                        <DataGridTextColumn Header="Market (₹/g)" Binding="{Binding RatePerGram, StringFormat={}{0:N2}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right: Set Daily Rate Form -->
        <StackPanel Grid.Column="1" Padding="16,0,0,0">
            <TextBlock Text="Set Daily Gold Rate (இன்றைய தங்கம் விலை)" FontWeight="Bold" FontSize="16"/>
            <Separator Margin="0,8"/>

            <TextBlock Text="Rate Date:"/>
            <DatePicker x:Name="DpDate" Margin="0,4"/>

            <TextBlock Text="22 Karat Rate (₹ per gram) (* Standard appraisal base):" Margin="0,8,0,0"/>
            <TextBox x:Name="Txt22KRate" Text="6500.00"/>

            <TextBlock Text="18 Karat Rate (₹ per gram):" Margin="0,8,0,0"/>
            <TextBox x:Name="Txt18KRate" Text="5300.00"/>

            <TextBlock Text="Market Rate / Bullion Rate (₹ per gram):" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtMarketRate" Text="7100.00"/>

            <TextBlock Text="Source / Market Reference:" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtSource" Text="Chennai Bullion Market"/>

            <Button Content="Save Today's Rate (F10)" Background="#2E7D32" FontWeight="Bold" Click="OnSaveRateClick" Width="180" HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

