<UserControl x:Class="JGF.Desktop.Views.Controls.GoldRateMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Recent Gold Rates -->
        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,12,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DAILY GOLD RATES (PAST 30 DAYS)" Style="{StaticResource SubheadingTextStyle}" Foreground="{StaticResource PrimaryDeepBlueBrush}" Margin="0,0,0,10"/>
                <DataGrid x:Name="GridRates" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" TabIndex="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MMM-yyyy}}" Width="120"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="22K Rate (₹/g)" Binding="{Binding Rate22K, StringFormat={}{0:N2}}" Width="130" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Market (₹/g)" Binding="{Binding RatePerGram, StringFormat={}{0:N2}}" Width="*"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right: Set Daily Rate Form -->
        <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}">
            <StackPanel>
                <TextBlock Text="Set Daily Gold Rate (இன்றைய தங்கம் விலை)" Style="{StaticResource SubheadingTextStyle}"/>
                <Separator Margin="0,10,0,14" Background="{StaticResource BorderLightBrush}"/>

                <TextBlock Text="Rate Date:" Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker x:Name="DpDate" Width="200" HorizontalAlignment="Left" TabIndex="1"/>

                <TextBlock Text="22 Karat Rate (₹ per gram) (* Standard appraisal base):" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                <TextBox x:Name="Txt22KRate" Text="6500.00" TabIndex="2"/>

                <TextBlock Text="18 Karat Rate (₹ per gram):" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                <TextBox x:Name="Txt18KRate" Text="5300.00" TabIndex="3"/>

                <TextBlock Text="Market Rate / Bullion Rate (₹ per gram):" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                <TextBox x:Name="TxtMarketRate" Text="7100.00" TabIndex="4"/>

                <TextBlock Text="Source / Market Reference:" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0"/>
                <TextBox x:Name="TxtSource" Text="Chennai Bullion Market" TabIndex="5"/>

                <Button Content="Save Today's Rate" Width="180" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveRateClick" HorizontalAlignment="Right" Margin="0,24,0,0" TabIndex="6"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
