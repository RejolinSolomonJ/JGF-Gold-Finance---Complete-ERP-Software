<UserControl x:Class="JGF.Desktop.Views.Controls.LoanHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LOAN TRANSACTION TIMELINE &amp; SUB-LEDGER" FontWeight="Bold" FontSize="16" Foreground="#B8860B" Margin="0,0,0,10"/>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="#F0F0F0" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Enter GL Loan Number:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtLoanNo" Width="220" VerticalContentAlignment="Center" Text="S1/24-25/0001"/>
                <Button Content="Show History" Margin="8,0,0,0" Background="#B8860B" FontWeight="Bold" Width="120" Click="OnLoadHistoryClick"/>
            </StackPanel>
        </Border>

        <!-- Ledger Entries Table -->
        <DataGrid x:Name="GridHistory" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" BorderBrush="#CCCCCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Transaction Type" Binding="{Binding EntryType}" Width="150"/>
                <DataGridTextColumn Header="Debit (₹)" Binding="{Binding DebitAmount, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn Header="Credit (₹)" Binding="{Binding CreditAmount, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn Header="Balance (₹)" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="130"/>
                <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
