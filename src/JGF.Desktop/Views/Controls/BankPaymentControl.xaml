<UserControl x:Class="JGF.Desktop.Views.Controls.BankPaymentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Search Bar -->
            <RowDefinition Height="Auto"/> <!-- Bank Pledge Details Card -->
            <RowDefinition Height="*"/>    <!-- Linked Customer Loans & Release Selection Card -->
            <RowDefinition Height="Auto"/> <!-- Payment & RZ Voucher Entry Card -->
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Find Bank Pledge (Pledge No / Bank A/C No):" Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtSearchQuery" Width="240" Text="BP-" KeyDown="OnSearchKeyDown" TabIndex="0"/>
                    <Button Content="🔍 Load Pledge" Width="130" Height="36" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="OnLoadPledgeClick" TabIndex="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Payment Date:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpPaymentDate" Width="130" TabIndex="2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bank Pledge Snapshot Card -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bank / NBFC:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtBankName" Text="-" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtBankAccount" Text="A/C: -" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Pledge No &amp; Terms:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtPledgeNo" Text="-" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrandGoldBrush}"/>
                    <TextBlock x:Name="TxtRateAndMaturity" Text="Rate: - | Due: -" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Monthly Interest (Est):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtEstMonthlyInterest" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryDeepBlueBrush}"/>
                    <TextBlock Text="* Calculated on balance" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Active Bank Balance:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtActiveBankBalance" Text="₹ 0.00" FontWeight="Bold" FontSize="20" Foreground="{StaticResource DangerRedBrush}"/>
                    <TextBlock x:Name="TxtStatus" Text="Status: -" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Linked Customer Loans Grid with Partial Release Selector -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Linked Customer Loans &amp; Ornaments in Bank Custody" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Select checkbox to mark jewels RELEASED back to shop locker:" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"/>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="GridLinkedLoans" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" TabIndex="3">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Release Jewels" Binding="{Binding IsSelectedForRelease, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Customer Loan No" Binding="{Binding LoanNumber}" Width="150" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Pledged Net Wt (g)" Binding="{Binding NetWeight, StringFormat={}{0:F3}}" Width="130" IsReadOnly="True"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Customer Principal (₹)" Binding="{Binding LoanAmount, StringFormat={}{0:N2}}" Width="150" IsReadOnly="True" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Custody Status" Binding="{Binding CustodyStatus}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Payment & Voucher Posting Form -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                    <TextBlock Text="Payment Action:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbPaymentType" SelectedIndex="0" SelectionChanged="OnPaymentTypeChanged" TabIndex="4">
                        <ComboBoxItem Content="Monthly Interest Only"/>
                        <ComboBoxItem Content="Part Principal + Release"/>
                        <ComboBoxItem Content="Full Closure &amp; Release"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,10,6">
                    <TextBlock Text="Interest Paid to Bank (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtInterestPaid" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="5"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,10,6">
                    <TextBlock Text="Principal Repaid to Bank (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPrincipalPaid" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="6"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Bank Charges / Notice Fee (₹):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPostalCharges" Text="0.00" TextChanged="OnPaymentAmountChanged" TabIndex="7"/>
                </StackPanel>

                <!-- Total Amount & Save -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL BANK PAYMENT (CASH OUTFLOW):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalOutflow" Text="₹ 0.00" FontWeight="Bold" FontSize="22" Foreground="{StaticResource DangerRedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="BtnSavePayment" Content="Post Bank Payment (Issue RZ Receipt)" Height="36" Style="{StaticResource PrimaryButtonStyle}" Padding="16,0" Click="OnSaveBankPaymentClick" TabIndex="8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
