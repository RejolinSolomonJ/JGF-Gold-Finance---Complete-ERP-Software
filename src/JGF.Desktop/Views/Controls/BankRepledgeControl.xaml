<UserControl x:Class="JGF.Desktop.Views.Controls.BankRepledgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <TabControl x:Name="RepledgeTabControl" Background="White" BorderBrush="#CCCCCC">
            <!-- Tab 1: Bank Pledges Dashboard & Overview -->
            <TabItem Header="📋 Pledges Dashboard" FontWeight="SemiBold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Master Grid -->
                        <RowDefinition Height="Auto"/> <!-- Status Note -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0F0F0" Padding="8" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="BANK RE-PLEDGES (மறு அடமானம் பட்டியல்)" FontWeight="Bold" FontSize="15" Foreground="#B8860B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="🔄 Refresh List" Width="110" Margin="0,0,8,0" Click="OnRefreshClick"/>
                                <Button Content="+ Go To New Pledge" Background="#B8860B" FontWeight="Bold" Width="160" Click="OnGoToNewPledgeTabClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="GridPledges" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="OnPledgeSelected" BorderBrush="#CCCCCC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bank" Binding="{Binding BankName}" Width="160"/>
                            <DataGridTextColumn Header="Pledge Number" Binding="{Binding PledgeNumber}" Width="130"/>
                            <DataGridTextColumn Header="Bank A/C No" Binding="{Binding BankAccountOrLoanNumber}" Width="130"/>
                            <DataGridTextColumn Header="Pledge Date" Binding="{Binding PledgeDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Maturity Date" Binding="{Binding MaturityDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Rate (%/mo)" Binding="{Binding InterestRate, StringFormat={}{0:F2}}" Width="90"/>
                            <DataGridTextColumn Header="Bank Borrowing (₹)" Binding="{Binding DisbursedAmount, StringFormat={}{0:N2}}" Width="140"/>
                            <DataGridTextColumn Header="Customer Loans" Binding="{Binding ActivePledgedLoansCount}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTemplateColumn Header="Action" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Make Payment / Release" Padding="8,2" Background="#1565C0" Click="OnMakePaymentForPledgeClick"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FFF9C4" Padding="8,4" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtDashboardNotice" Text="💡 Tip: Click 'Make Payment / Release' on any row or switch to the Payment tab to service interest, principal or release customer jewels." Foreground="#795548"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: New Bank Entry -->
            <TabItem Header="+ New Bank Entry" FontWeight="SemiBold">
                <ContentControl x:Name="NewEntryContentHost"/>
            </TabItem>

            <!-- Tab 3: Bank Account Payment & RZ Voucher -->
            <TabItem Header="💳 Bank Payment (RZ Series)" FontWeight="SemiBold">
                <ContentControl x:Name="PaymentContentHost"/>
            </TabItem>

            <!-- Tab 4: Custody & Analytical Reports -->
            <TabItem Header="📊 Reports &amp; Stock Custody" FontWeight="SemiBold">
                <ContentControl x:Name="ReportsContentHost"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
