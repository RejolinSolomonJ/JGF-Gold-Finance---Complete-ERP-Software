<UserControl x:Class="JGF.Desktop.Views.Controls.NoticeAuctionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundLightBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Page Title & Statutory Banner -->
            <RowDefinition Height="*"/>    <!-- Main Tabbed Interface -->
        </Grid.RowDefinitions>

        <!-- Top Header & Legal Disclaimer Card -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,14" Padding="16,12" Background="#FFFFFF">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                        <TextBlock Text="⚖" FontSize="18" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OVERDUE, NOTICES &amp; AUCTION RECOVERY" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryDeepBlueBrush}"/>
                        <TextBlock Text="தவணை தவறியவை, சட்டப்பூர்வ அறிவிப்புகள் &amp; ஏல மீட்பு நடைமுறை" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠ " FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="Statutory Rule: Auction strictly requires 15-day pre-notice &amp; Owner Approval"
                                   FontWeight="SemiBold" FontSize="11" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" x:Name="NoticeTabControl" Background="White" BorderBrush="{DynamicResource BorderLightBrush}">
            
            <!-- TAB 1: Overdue Loans Tracker -->
            <TabItem Header="⏳ Overdue Tracker" FontWeight="SemiBold" FontSize="13" Padding="16,8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- KPI Summary Stat Cards -->
                        <RowDefinition Height="Auto"/> <!-- Filters & Search Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Overdue Loans DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Batch Action Bar -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: KPI Summary Stat Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total Overdue Loans -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,8,0" Padding="14,10" Background="#FFFFFF">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Background="#EFF6FF" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL OVERDUE LOANS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtTotalOverdueCount" Text="0 Loans" FontSize="18" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Card 2: Total Dues Outstanding -->
                        <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="4,0,4,0" Padding="14,10" Background="#FFFFFF">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Background="#FFFBEB" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL OUTSTANDING DUES" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtTotalOverdueAmount" Text="₹0.00" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Card 3: Auction Eligible -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}" Margin="8,0,0,0" Padding="14,10" Background="#FFFFFF">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Background="#FEF2F2" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Text="🔨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="AUCTION ELIGIBLE (15d+ SERVED)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtAuctionEligibleCount" Text="0 Loans" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Filter & Search Toolbar -->
                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,10" Padding="12,10" Background="#F8FAFC">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Filter Category:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                                <ComboBox x:Name="CmbOverdueFilter" Width="180" Height="34" SelectionChanged="OnFilterCategoryChanged" Margin="0,0,16,0">
                                    <ComboBoxItem Content="All Overdue Loans" IsSelected="True"/>
                                    <ComboBoxItem Content="6-Month Reminder"/>
                                    <ComboBoxItem Content="12-Month Matured"/>
                                    <ComboBoxItem Content="Critical LTV (>90%)"/>
                                    <ComboBoxItem Content="Auction Eligible (15d+)"/>
                                </ComboBox>

                                <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                                <TextBox x:Name="TxtSearchOverdue" Width="260" Height="34" VerticalContentAlignment="Center" Padding="8,4"
                                         ToolTip="Search by GL Number, Customer Name, or Mobile" TextChanged="OnSearchTextChanged"/>
                            </StackPanel>

                            <Button DockPanel.Dock="Right" Content="🔄 Refresh Data" Width="130" Height="34"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnRefreshOverdueClick" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <!-- Row 2: Data Grid of Overdue Loans -->
                    <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="GridOverdueLoans" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="False" SelectionMode="Single" SelectionChanged="OnOverdueLoanSelected"
                                  RowHeight="36" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                <DataGridTextColumn Header="GL Number" Binding="{Binding LoanNumber}" IsReadOnly="True" FontWeight="Bold" Width="145"/>
                                <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" IsReadOnly="True" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Mobile No" Binding="{Binding CustomerMobile}" IsReadOnly="True" Width="115"/>
                                <DataGridTextColumn Header="Pledge Date" Binding="{Binding PledgeDate, StringFormat={}{0:dd-MMM-yyyy}}" IsReadOnly="True" Width="110"
                                                    HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Months" Binding="{Binding ElapsedMonths}" IsReadOnly="True" Width="70"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Principal (₹)" Binding="{Binding PrincipalBalance, StringFormat={}{0:N2}}" IsReadOnly="True" Width="120"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Interest Due (₹)" Binding="{Binding AccruedInterest, StringFormat={}{0:N2}}" IsReadOnly="True" Width="125"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Total Dues (₹)" Binding="{Binding TotalOutstanding, StringFormat={}{0:N2}}" IsReadOnly="True" FontWeight="Bold" Width="135"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Gold Value (₹)" Binding="{Binding CurrentGoldValue, StringFormat={}{0:N2}}" IsReadOnly="True" Width="125"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="LTV %" Binding="{Binding CurrentLtvRatio, StringFormat={}{0:F1}%}" IsReadOnly="True" Width="75"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Bucket Category" Binding="{Binding Bucket}" IsReadOnly="True" Width="125"
                                                    HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Notices" Binding="{Binding NoticesSentCount}" IsReadOnly="True" Width="70"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                                <DataGridTextColumn Header="Last Notice" Binding="{Binding LastNoticeDate, StringFormat={}{0:dd-MMM-yyyy}}" IsReadOnly="True" Width="110"
                                                    HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                                <DataGridCheckBoxColumn Header="Auction Ready" Binding="{Binding IsAuctionEligible}" IsReadOnly="True" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Row 3: Action Bar -->
                    <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}" Margin="0,10,0,0" Padding="12,10" Background="#FFFFFF">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Content="Select All" Width="100" Height="36" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnSelectAllClick"/>
                                <Button Content="Clear All" Width="100" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearAllClick"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="✉ Prepare Notice for Selected" Height="36" Padding="18,0" Margin="0,0,10,0"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OnGoToPrepareNoticeClick"/>
                                <Button Content="🔨 Schedule Auction for Selected" Height="36" Padding="18,0"
                                        Style="{StaticResource DangerButtonStyle}" Click="OnGoToAuctionWorkflowClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Bilingual Notice Generator & Dispatch -->
            <TabItem Header="✉ Notice Generator" FontWeight="SemiBold" FontSize="13" Padding="16,8">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/> <!-- Notice Parameters & Dispatch Form -->
                        <ColumnDefinition Width="*"/>   <!-- Live Bilingual Letter Preview -->
                    </Grid.ColumnDefinitions>

                    <!-- Notice Generation Form -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,0,12,0" Background="#FFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Issue Legal Notice / Demand" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryDeepBlueBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="சட்டப்பூர்வ அறிவிப்பு தயாரித்தல் மற்றும் பதிவு செய்தல்" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Selected Loans Count: " FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock x:Name="TxtSelectedNoticeCount" Text="0 loans selected" Foreground="#DC2626" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Notice Type / அறிவிப்பு வகை:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <ComboBox x:Name="CmbNoticeType" Height="34" Margin="0,0,0,12" SelectionChanged="OnNoticeFormChanged">
                                    <ComboBoxItem Content="First Reminder (6-Month)" Tag="Reminder" IsSelected="True"/>
                                    <ComboBoxItem Content="Final Maturity Notice (12-Month)" Tag="FinalNotice"/>
                                    <ComboBoxItem Content="Statutory Pre-Auction Notice (15-Day)" Tag="AuctionNotice"/>
                                    <ComboBoxItem Content="Urgent Demand Notice" Tag="DemandNotice"/>
                                </ComboBox>

                                <TextBlock Text="Delivery Mode / அனுப்பும் முறை:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <ComboBox x:Name="CmbDeliveryMode" Height="34" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Registered Post with Ack Due (RPAD)" Tag="RegisteredPost" IsSelected="True"/>
                                    <ComboBoxItem Content="Speed Post" Tag="SpeedPost"/>
                                    <ComboBoxItem Content="Hand Delivery with Signature" Tag="HandDelivery"/>
                                    <ComboBoxItem Content="Courier Service" Tag="Courier"/>
                                    <ComboBoxItem Content="SMS / WhatsApp Notice" Tag="Sms"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Notice Date:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <DatePicker x:Name="DpNoticeDate" Height="34" SelectedDateChanged="OnNoticeFormChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Grace Due Date:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <DatePicker x:Name="DpNoticeDueDate" Height="34" SelectedDateChanged="OnNoticeFormChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Postal / Delivery Reference No:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <TextBox x:Name="TxtPostalRef" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"
                                         ToolTip="e.g. Registered Post AD Article No: RN123456789IN"/>

                                <TextBlock Text="Remarks / குறிப்பு:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <TextBox x:Name="TxtNoticeRemarks" Height="65" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <Button Content="💾 Issue &amp; Record Notice Batch" Height="40"
                                        Style="{StaticResource SuccessButtonStyle}" Click="OnIssueNoticeBatchClick"/>
                                <TextBlock Text="* Records statutory notice in DB and updates loan notice history"
                                           FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Letter Preview Panel -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Padding="16" Background="#FFFFFF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Preview Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Letter Text Viewer -->
                                <RowDefinition Height="Auto"/> <!-- Print & Export Actions -->
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Notice Letter Preview" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryDeepBlueBrush}" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="RbTamil" Content="தமிழ் (Tamil)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnLanguageChanged"/>
                                    <RadioButton x:Name="RbEnglish" Content="English" VerticalAlignment="Center" Checked="OnLanguageChanged"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="🔄 Regenerate Preview" Width="160" Height="32"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnRegeneratePreviewClick"/>
                            </DockPanel>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtNoticeLetterPreview" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas, Segoe UI, Noto Sans Tamil" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="🖨 Print Notice Letters" Width="170" Height="36" Margin="0,0,10,0"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OnPrintNoticeClick"/>
                                <Button Content="📥 Export Batch (CSV/Txt)" Width="190" Height="36"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnExportNoticeClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Auction Workflow & Settlement -->
            <TabItem Header="🔨 Auction Workflow" FontWeight="SemiBold" FontSize="13" Padding="16,8">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Stage 1: Scheduling & Approval -->
                        <ColumnDefinition Width="*"/>   <!-- Stage 2: Conduct & Settle -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scheduling & Approval -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,0,8,0" Background="#FFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 1: Statutory Auction Scheduling" FontWeight="Bold" FontSize="15" Foreground="#DC2626" Margin="0,0,0,4"/>
                                <TextBlock Text="Only loans with 15-day Pre-Auction Notice served are eligible for scheduling." FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                                <TextBlock Text="Select Auction-Eligible Loan:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <ComboBox x:Name="CmbAuctionEligibleLoans" Height="34" DisplayMemberPath="LoanNumber" SelectionChanged="OnAuctionLoanSelectionChanged" Margin="0,0,0,12"/>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Loan &amp; Collateral Summary:" FontWeight="Bold" Foreground="#334155"/>
                                        <TextBlock x:Name="TxtAuctionLoanDetails" Text="Select a loan to view customer dues and gold details." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Scheduled Auction Date:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <DatePicker x:Name="DpAuctionDate" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Reserve Price (₹):" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <TextBox x:Name="TxtReservePrice" Height="34" VerticalContentAlignment="Center" Text="0.00"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Auction Place / Venue:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <TextBox x:Name="TxtAuctionVenue" Height="34" VerticalContentAlignment="Center" Text="JGF Finance Head Office, Main Bazaar" Margin="0,0,0,14"/>

                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                    <TextBlock Text="⚖ OWNER APPROVAL GATE: The Tamil Nadu Pawnbrokers Act mandates statutory notice and Owner authorization before public auction."
                                               FontSize="11" Foreground="#991B1B" TextWrapping="Wrap"/>
                                </Border>

                                <Button Content="✔ Approve &amp; Schedule Auction (Owner Only)" Height="40"
                                        Style="{StaticResource DangerButtonStyle}" Click="OnApproveScheduleAuctionClick"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Bidding, Settlement & Vouchers -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="8,0,0,0" Background="#FFFFFF">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 2: Auction Conduct &amp; Financial Settlement" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryDeepBlueBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Record winning bid, valuer/hall expenses, and generate balanced double-entry vouchers." FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                                <TextBlock Text="Active Scheduled Auction:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <ComboBox x:Name="CmbScheduledAuctions" Height="34" DisplayMemberPath="DisplayInfo" SelectionChanged="OnScheduledAuctionSelectionChanged" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Winning Bid / Sale Price (₹):" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <TextBox x:Name="TxtSalePrice" Height="34" VerticalContentAlignment="Center" Text="0.00" TextChanged="OnAuctionSettlementInputChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Auction Expenses (₹):" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <TextBox x:Name="TxtAuctionExpenses" Height="34" VerticalContentAlignment="Center" Text="0.00" TextChanged="OnAuctionSettlementInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Winning Buyer Name:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <TextBox x:Name="TxtBuyerName" Height="34" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Buyer Address / Phone:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                        <TextBox x:Name="TxtBuyerAddress" Height="34" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Financial Outcome Calculation Box -->
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Accounting &amp; Settlement Outcome:" FontWeight="Bold" Foreground="#166534"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="TxtCalcLoanDues" Text="Total Dues: ₹0.00" Foreground="#334155"/>
                                                <TextBlock x:Name="TxtCalcSaleNet" Text="Net Proceeds: ₹0.00" Foreground="#334155" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="TxtCalcSurplus" Text="Surplus Payable: ₹0.00" FontWeight="Bold" Foreground="#15803D"/>
                                                <TextBlock x:Name="TxtCalcDeficit" Text="Deficit / Loss: ₹0.00" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Settlement Remarks:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#334155"/>
                                <TextBox x:Name="TxtAuctionSettlementRemarks" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                                <Button Content="💰 Settle Auction &amp; Post Double-Entry Vouchers" Height="40"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OnConductSettleAuctionClick"/>
                                <TextBlock Text="* Posts Debit Cash, Credits Jewel Loan &amp; Interest, and books Surplus Payable or Bad Debt Deficit."
                                           FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: Reports & Statutory Registers -->
            <TabItem Header="📊 Registers &amp; Reports" FontWeight="SemiBold" FontSize="13" Padding="16,8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Report Selector & Export -->
                        <RowDefinition Height="*"/>    <!-- Report Data Grid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="12,10" Margin="0,0,0,10" Background="#F8FAFC">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Select Statutory Register:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                                <ComboBox x:Name="CmbReportType" Width="260" Height="34" SelectionChanged="OnReportTypeChanged">
                                    <ComboBoxItem Content="1. Overdue Summary Report" IsSelected="True"/>
                                    <ComboBoxItem Content="2. Notices Sent Register (RPAD Tracking)"/>
                                    <ComboBoxItem Content="3. Auction Eligible Loans"/>
                                    <ComboBoxItem Content="4. Auction Register (with Vouchers)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="🔄 Refresh" Width="110" Height="34" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnRefreshReportClick"/>
                                <Button Content="📤 Export to CSV" Width="140" Height="34"
                                        Style="{StaticResource SuccessButtonStyle}" Click="OnExportReportCsvClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="0" ClipToBounds="True">
                        <DataGrid x:Name="GridReports" AutoGenerateColumns="True" IsReadOnly="True"
                                  RowHeight="34" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" Background="White"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: Legal & Statutory Parameters Settings -->
            <TabItem Header="⚙ Legal Parameters" FontWeight="SemiBold" FontSize="13" Padding="16,8">
                <Grid Margin="16">
                    <Border Style="{StaticResource ModernCardStyle}" Padding="20" MaxWidth="720" HorizontalAlignment="Left" Background="#FFFFFF">
                        <StackPanel>
                            <TextBlock Text="Statutory Notice &amp; Auction Legal Thresholds" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryDeepBlueBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Configure overdue aging and statutory notice grace intervals in compliance with local regulations." FontSize="12" Foreground="#64748B" Margin="0,0,0,18"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="First Reminder Notice Threshold:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsFirstNoticeMonths" Height="34" VerticalContentAlignment="Center" Text="6" ToolTip="Months after pledge or last payment"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Final Maturity Notice Threshold:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsFinalNoticeMonths" Height="34" VerticalContentAlignment="Center" Text="12" ToolTip="Months after pledge date"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Statutory Pre-Auction Notice Grace Days:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsAuctionGraceDays" Height="34" VerticalContentAlignment="Center" Text="15" ToolTip="Minimum mandatory notice duration before auction can take place"/>
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Critical LTV Threshold (%):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsCriticalLtv" Height="34" VerticalContentAlignment="Center" Text="90.0" ToolTip="Mark as critical when outstanding dues exceed this % of market gold value"/>
                            </Grid>

                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="⚖ Retained Legal Advocate Disclaimer:" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="Notice periods, auction publication procedures, approved auctioneers, and surplus returns are governed by the Tamil Nadu Pawnbrokers Act, 1943. Always verify parameters with your advocate."
                                               FontSize="11" Foreground="#78350F" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <CheckBox x:Name="ChkAdvocateConfirmation" Content="I confirm legal parameters have been verified with legal counsel." FontWeight="SemiBold" Foreground="#92400E"/>
                                </StackPanel>
                            </Border>

                            <Button Content="💾 Save Statutory Settings" Width="240" Height="38" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveSettingsClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
