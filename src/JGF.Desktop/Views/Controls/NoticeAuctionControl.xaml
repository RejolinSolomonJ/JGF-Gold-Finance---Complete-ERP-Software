<UserControl x:Class="JGF.Desktop.Views.Controls.NoticeAuctionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Legal Warning Banner -->
            <RowDefinition Height="*"/>    <!-- Main Tabbed Interface -->
        </Grid.RowDefinitions>

        <!-- Top Header & Legal Disclaimer -->
        <Border Grid.Row="0" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="⚖ OVERDUE, NOTICES &amp; AUCTION RECOVERY" FontWeight="Bold" FontSize="16" Foreground="#B78103"/>
                    <TextBlock Text=" | தவணை தவறியவை, அறிவிப்புகள் மற்றும் ஏல நடவடிக்கை" FontSize="13" Foreground="#666666" Margin="10,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="⚠ Statutory Rule: Auction strictly requires 15-day pre-notice &amp; Owner Approval" FontWeight="SemiBold" FontSize="11" Foreground="#C62828"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" x:Name="NoticeTabControl" Background="White" BorderBrush="#CCCCCC">
            
            <!-- TAB 1: Overdue Loans Tracker -->
            <TabItem Header="⏳ Overdue Loans Tracker (தவணை பட்டியல்)" FontWeight="SemiBold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filters & Stats -->
                        <RowDefinition Height="*"/>    <!-- Data Grid -->
                        <RowDefinition Height="Auto"/> <!-- Batch Action Bar -->
                    </Grid.RowDefinitions>

                    <!-- Filter & Statistics Panel -->
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="Filter Category:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbOverdueFilter" Width="160" SelectionChanged="OnFilterCategoryChanged">
                                    <ComboBoxItem Content="All Overdue Loans" IsSelected="True"/>
                                    <ComboBoxItem Content="6-Month Reminder"/>
                                    <ComboBoxItem Content="12-Month Matured"/>
                                    <ComboBoxItem Content="Critical LTV (>90%)"/>
                                    <ComboBoxItem Content="Auction Eligible (15d+)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtSearchOverdue" Width="180" Padding="4" ToolTip="Search by Loan No, Customer Name or Mobile" TextChanged="OnSearchTextChanged"/>
                            </StackPanel>

                            <!-- KPI Summary Badges -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#E8EAF6" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtTotalOverdueCount" Text="Total Loans: 0" FontWeight="SemiBold" Foreground="#1A237E" FontSize="11"/>
                                </Border>
                                <Border Background="#FFF3E0" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtTotalOverdueAmount" Text="Total Dues: ₹0.00" FontWeight="SemiBold" Foreground="#E65100" FontSize="11"/>
                                </Border>
                                <Border Background="#FFEBEE" CornerRadius="3" Padding="8,4">
                                    <TextBlock x:Name="TxtAuctionEligibleCount" Text="Auction Eligible: 0" FontWeight="SemiBold" Foreground="#B71C1C" FontSize="11"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="3" Content="🔄 Refresh Data" Width="120" Click="OnRefreshOverdueClick" Background="#455A64" Foreground="White" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <!-- Data Grid of Overdue Loans -->
                    <DataGrid x:Name="GridOverdueLoans" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" SelectionMode="Single" SelectionChanged="OnOverdueLoanSelected">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="GL No" Binding="{Binding LoanNumber}" IsReadOnly="True" FontWeight="Bold" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Mobile" Binding="{Binding CustomerMobile}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="Pledge Date" Binding="{Binding PledgeDate, StringFormat={}{0:dd-MMM-yyyy}}" IsReadOnly="True" Width="105"
                                                HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Months" Binding="{Binding ElapsedMonths}" IsReadOnly="True" Width="65"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Principal (₹)" Binding="{Binding PrincipalBalance, StringFormat={}{0:N2}}" IsReadOnly="True" Width="110"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Interest Due (₹)" Binding="{Binding AccruedInterest, StringFormat={}{0:N2}}" IsReadOnly="True" Width="110"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Total Dues (₹)" Binding="{Binding TotalOutstanding, StringFormat={}{0:N2}}" IsReadOnly="True" FontWeight="Bold" Width="120"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Gold Value (₹)" Binding="{Binding CurrentGoldValue, StringFormat={}{0:N2}}" IsReadOnly="True" Width="110"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="LTV %" Binding="{Binding CurrentLtvRatio, StringFormat={}{0:F1}%}" IsReadOnly="True" Width="75"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Bucket Category" Binding="{Binding Bucket}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Notices" Binding="{Binding NoticesSentCount}" IsReadOnly="True" Width="65"
                                                HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                            <DataGridTextColumn Header="Last Notice" Binding="{Binding LastNoticeDate, StringFormat={}{0:dd-MMM-yyyy}}" IsReadOnly="True" Width="105"
                                                HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>
                            <DataGridCheckBoxColumn Header="Auction Ready" Binding="{Binding IsAuctionEligible}" IsReadOnly="True" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action Bar -->
                    <Border Grid.Row="2" Background="#EEEEEE" Padding="8" Margin="0,8,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="Select All" Width="90" Margin="0,0,6,0" Click="OnSelectAllClick"/>
                                <Button Content="Clear All" Width="90" Click="OnClearAllClick"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="✉ Prepare Notice for Selected" Background="#0288D1" Foreground="White" FontWeight="Bold" Width="220" Margin="0,0,8,0" Click="OnGoToPrepareNoticeClick"/>
                                <Button Content="🔨 Schedule Auction for Selected" Background="#C62828" Foreground="White" FontWeight="Bold" Width="220" Click="OnGoToAuctionWorkflowClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Bilingual Notice Generator & Dispatch -->
            <TabItem Header="✉ Notice Generator &amp; Letters (அறிவிப்புகள்)" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/> <!-- Notice Parameters & Dispatch Form -->
                        <ColumnDefinition Width="*"/>   <!-- Live Bilingual Letter Preview -->
                    </Grid.ColumnDefinitions>

                    <!-- Notice Generation Form -->
                    <Border Grid.Column="0" Background="#FDFDFD" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Issue Legal Notice / Demand" FontWeight="Bold" FontSize="14" Foreground="#1565C0" Margin="0,0,0,12"/>

                            <TextBlock Text="Selected Loans Count:" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtSelectedNoticeCount" Text="0 loans selected" Foreground="#C62828" FontWeight="Bold" Margin="0,2,0,10"/>

                            <TextBlock Text="Notice Type / அறிவிப்பு வகை:"/>
                            <ComboBox x:Name="CmbNoticeType" Margin="0,2,0,10" SelectionChanged="OnNoticeFormChanged">
                                <ComboBoxItem Content="First Reminder (6-Month)" Tag="Reminder" IsSelected="True"/>
                                <ComboBoxItem Content="Final Maturity Notice (12-Month)" Tag="FinalNotice"/>
                                <ComboBoxItem Content="Statutory Pre-Auction Notice (15-Day)" Tag="AuctionNotice"/>
                                <ComboBoxItem Content="Urgent Demand Notice" Tag="DemandNotice"/>
                            </ComboBox>

                            <TextBlock Text="Delivery Mode / அனுப்பும் முறை:"/>
                            <ComboBox x:Name="CmbDeliveryMode" Margin="0,2,0,10">
                                <ComboBoxItem Content="Registered Post with Ack Due (RPAD)" Tag="RegisteredPost" IsSelected="True"/>
                                <ComboBoxItem Content="Speed Post" Tag="SpeedPost"/>
                                <ComboBoxItem Content="Hand Delivery with Signature" Tag="HandDelivery"/>
                                <ComboBoxItem Content="Courier Service" Tag="Courier"/>
                                <ComboBoxItem Content="SMS / WhatsApp Notice" Tag="Sms"/>
                            </ComboBox>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Notice Date:"/>
                                    <DatePicker x:Name="DpNoticeDate" SelectedDateChanged="OnNoticeFormChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Grace Due Date:"/>
                                    <DatePicker x:Name="DpNoticeDueDate" SelectedDateChanged="OnNoticeFormChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Postal / Delivery Reference No:"/>
                            <TextBox x:Name="TxtPostalRef" Margin="0,2,0,10" ToolTip="e.g. Registered Post AD Article No: RN123456789IN"/>

                            <TextBlock Text="Remarks / குறிப்பு:"/>
                            <TextBox x:Name="TxtNoticeRemarks" Height="60" TextWrapping="Wrap" Margin="0,2,0,16"/>

                            <Button Content="💾 Issue &amp; Record Notice Batch" Height="40" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="13" Click="OnIssueNoticeBatchClick"/>
                            <TextBlock Text="* Records statutory notice in DB and updates loan notice history" FontSize="11" Foreground="#777777" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Letter Preview Panel -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Preview Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Letter Text Viewer -->
                                <RowDefinition Height="Auto"/> <!-- Print & Export Actions -->
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="Notice Letter Preview" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="RbTamil" Content="தமிழ் (Tamil)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnLanguageChanged"/>
                                    <RadioButton x:Name="RbEnglish" Content="English" VerticalAlignment="Center" Checked="OnLanguageChanged"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="🔄 Regenerate Preview" Width="140" Click="OnRegeneratePreviewClick"/>
                            </DockPanel>

                            <Border Grid.Row="1" Background="#FBFBFB" BorderBrush="#EEEEEE" BorderThickness="1" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtNoticeLetterPreview" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas, Segoe UI, Latha" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="🖨 Print Notice Letters" Width="150" Height="32" Background="#1565C0" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" Click="OnPrintNoticeClick"/>
                                <Button Content="📥 Export Batch (CSV/Txt)" Width="170" Height="32" Click="OnExportNoticeClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Auction Workflow & Settlement -->
            <TabItem Header="🔨 Auction Workflow &amp; Settlement (ஏல நடைமுறை)" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Stage 1 & 2: Eligibility & Approval -->
                        <ColumnDefinition Width="*"/>   <!-- Stage 3: Conduct & Settle -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Scheduling & Approval -->
                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 1: Statutory Auction Scheduling" FontWeight="Bold" FontSize="14" Foreground="#C62828" Margin="0,0,0,8"/>
                                <TextBlock Text="Only loans with 15-day Pre-Auction Notice served are eligible for scheduling." FontSize="11" Foreground="#666666" Margin="0,0,0,12"/>

                                <TextBlock Text="Select Auction-Eligible Loan:" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbAuctionEligibleLoans" DisplayMemberPath="LoanNumber" SelectionChanged="OnAuctionLoanSelectionChanged" Margin="0,2,0,10"/>

                                <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Loan &amp; Collateral Summary:" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock x:Name="TxtAuctionLoanDetails" Text="Select a loan to view customer dues and gold details." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#555555"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Scheduled Auction Date:"/>
                                        <DatePicker x:Name="DpAuctionDate"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Reserve Price (₹):"/>
                                        <TextBox x:Name="TxtReservePrice" Text="0.00"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Auction Place / Venue:"/>
                                <TextBox x:Name="TxtAuctionVenue" Text="JGF Finance Head Office, Main Bazaar" Margin="0,2,0,14"/>

                                <Border Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="⚖ OWNER APPROVAL GATE: The Tamil Nadu Pawnbrokers Act mandates statutory notice and Owner authorization before public auction." FontSize="11" Foreground="#B71C1C" TextWrapping="Wrap"/>
                                </Border>

                                <Button Content="✔ Approve &amp; Schedule Auction (Owner Only)" Height="38" Background="#C62828" Foreground="White" FontWeight="Bold" Click="OnApproveScheduleAuctionClick"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Bidding, Settlement & Vouchers -->
                    <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 2: Auction Conduct &amp; Financial Settlement" FontWeight="Bold" FontSize="14" Foreground="#1565C0" Margin="0,0,0,8"/>
                                <TextBlock Text="Record winning bid, valuer/hall expenses, and generate balanced double-entry vouchers." FontSize="11" Foreground="#666666" Margin="0,0,0,12"/>

                                <TextBlock Text="Active Scheduled Auction:" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbScheduledAuctions" DisplayMemberPath="DisplayInfo" SelectionChanged="OnScheduledAuctionSelectionChanged" Margin="0,2,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Winning Bid / Sale Price (₹):"/>
                                        <TextBox x:Name="TxtSalePrice" Text="0.00" TextChanged="OnAuctionSettlementInputChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Auction Expenses (₹):"/>
                                        <TextBox x:Name="TxtAuctionExpenses" Text="0.00" TextChanged="OnAuctionSettlementInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Winning Buyer Name:"/>
                                        <TextBox x:Name="TxtBuyerName" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Buyer Address / Phone:"/>
                                        <TextBox x:Name="TxtBuyerAddress" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Financial Outcome Calculation Box -->
                                <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Accounting &amp; Settlement Outcome:" FontWeight="Bold" Foreground="#1B5E20"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="TxtCalcLoanDues" Text="Total Dues: ₹0.00" Foreground="#333333"/>
                                                <TextBlock x:Name="TxtCalcSaleNet" Text="Net Proceeds: ₹0.00" Foreground="#333333" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="TxtCalcSurplus" Text="Surplus Payable: ₹0.00" FontWeight="Bold" Foreground="#2E7D32"/>
                                                <TextBlock x:Name="TxtCalcDeficit" Text="Deficit / Loss: ₹0.00" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Settlement Remarks:"/>
                                <TextBox x:Name="TxtAuctionSettlementRemarks" Margin="0,2,0,14"/>

                                <Button Content="💰 Settle Auction &amp; Post Double-Entry Vouchers" Height="40" Background="#1565C0" Foreground="White" FontWeight="Bold" Click="OnConductSettleAuctionClick"/>
                                <TextBlock Text="* Posts Debit Cash, Credits Jewel Loan &amp; Interest, and books Surplus Payable or Bad Debt Deficit." FontSize="11" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: Reports & Statutory Registers -->
            <TabItem Header="📊 Reports &amp; Registers (அறிக்கைகள் &amp; பதிவேடுகள்)" FontWeight="SemiBold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Report Selector & Export -->
                        <RowDefinition Height="*"/>    <!-- Report Data Grid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0F4F8" Padding="10" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="Select Statutory Register:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbReportType" Width="240" SelectionChanged="OnReportTypeChanged">
                                    <ComboBoxItem Content="1. Overdue Summary Report" IsSelected="True"/>
                                    <ComboBoxItem Content="2. Notices Sent Register (RPAD Tracking)"/>
                                    <ComboBoxItem Content="3. Auction Eligible Loans"/>
                                    <ComboBoxItem Content="4. Auction Register (with Vouchers)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="🔄 Refresh" Width="100" Margin="0,0,8,0" Click="OnRefreshReportClick"/>
                                <Button Content="📤 Export to CSV" Width="130" Background="#2E7D32" Foreground="White" FontWeight="Bold" Click="OnExportReportCsvClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="GridReports" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" BorderBrush="#CCCCCC"/>
                </Grid>
            </TabItem>

            <!-- TAB 5: Legal & Statutory Parameters Settings -->
            <TabItem Header="⚙ Legal Parameters (சட்ட விதிகள்)" FontWeight="SemiBold">
                <Grid Margin="16">
                    <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="16" MaxWidth="700" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Statutory Notice &amp; Auction Legal Thresholds" FontWeight="Bold" FontSize="15" Foreground="#37474F" Margin="0,0,0,8"/>
                            <TextBlock Text="Configure overdue aging and statutory notice grace intervals in compliance with local regulations." FontSize="12" Foreground="#666666" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="First Reminder Notice Threshold:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsFirstNoticeMonths" Text="6" ToolTip="Months after pledge or last payment"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Final Maturity Notice Threshold:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsFinalNoticeMonths" Text="12" ToolTip="Months after pledge date"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Statutory Pre-Auction Notice Grace Days:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsAuctionGraceDays" Text="15" ToolTip="Minimum mandatory notice duration before auction can take place"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Critical LTV Threshold (%):" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtSettingsCriticalLtv" Text="90.0" ToolTip="Mark as critical when outstanding dues exceed this % of market gold value"/>
                            </Grid>

                            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" Padding="10" Margin="0,0,0,16">
                                <StackPanel>
