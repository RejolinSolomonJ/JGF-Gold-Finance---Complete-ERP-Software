<UserControl x:Class="JGF.Desktop.Views.Controls.NewLoanEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Section -->
            <RowDefinition Height="Auto"/> <!-- Customer & Scheme Row Card -->
            <RowDefinition Height="*"/>    <!-- Collateral Jewel Breakdown Grid -->
            <RowDefinition Height="Auto"/> <!-- Summary & Loan Disbursal Card -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="NEW JEWEL LOAN ENTRY (புதிய நகை கடன் பதிவு)" Style="{StaticResource HeadingTextStyle}" Foreground="{StaticResource PrimaryDeepBlueBrush}" Margin="0,0,0,12"/>

        <!-- Customer & Scheme Selection Section -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Customer Search / Pick -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                    <TextBlock Text="Customer (* Name / Code / Mobile):" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel>
                        <Button Content="🔍 Select Customer" DockPanel.Dock="Right" Width="130" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnPickCustomerClick" TabIndex="1"/>
                        <TextBox x:Name="TxtCustomerSearch" IsReadOnly="True" Background="{StaticResource SurfaceAltBrush}" TabIndex="0"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtCustomerError" Text="Please select a customer." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Scheme -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,10,6">
                    <TextBlock Text="Loan Scheme (*):" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbScheme" SelectionChanged="OnSchemeChanged" TabIndex="2"/>
                </StackPanel>

                <!-- Pledge Date -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,10,6">
                    <TextBlock Text="Pledge Date:" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DpPledgeDate" TabIndex="3"/>
                </StackPanel>

                <!-- Packet Number -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Locker Packet / Barcode:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPacket" Text="PKT-AUTO" TabIndex="4"/>
                </StackPanel>

                <!-- Nominee Row -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,10,0">
                    <TextBlock Text="Nominee Name:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtNominee" TabIndex="5"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,6,10,0">
                    <TextBlock Text="Relationship:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtNomineeRel" Text="Spouse" TabIndex="6"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,6,0,0" Grid.ColumnSpan="2">
                    <TextBlock Text="Jewel Scale Photo:" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel>
                        <Button Content="📷 Webcam" DockPanel.Dock="Right" Width="95" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnCaptureJewelWebcamClick" TabIndex="8" Margin="4,0,0,0" ToolTip="Take jewel scale photo using webcam directly"/>
                        <Button Content="📁 Browse" DockPanel.Dock="Right" Width="85" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnAttachJewelPhotoClick" TabIndex="8"/>
                        <TextBox x:Name="TxtPhotoPath" IsReadOnly="True" Background="{StaticResource SurfaceAltBrush}" TabIndex="7"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Jewel Items Collateral Grid & Manual Entry Form -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Section Title Header -->
                    <RowDefinition Height="Auto"/> <!-- Manual Ornament Input Row -->
                    <RowDefinition Height="*"/>    <!-- DataGrid of Added Ornaments -->
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Collateral Jewels Breakdown (நகைகள் விவரம்)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="— Select ornament and enter weight manually to add items one by one" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
                
                <!-- Manual Ornament Entry Row -->
                <Border Grid.Row="1" Background="#F8FAFC" Padding="12,10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/> <!-- Ornament Type / Name -->
                            <ColumnDefinition Width="65"/>   <!-- Qty -->
                            <ColumnDefinition Width="100"/>  <!-- Gross (g) -->
                            <ColumnDefinition Width="95"/>   <!-- Deduct (g) -->
                            <ColumnDefinition Width="95"/>   <!-- Net (g) -->
                            <ColumnDefinition Width="85"/>   <!-- Purity % -->
                            <ColumnDefinition Width="110"/>  <!-- Rate/g (₹) -->
                            <ColumnDefinition Width="Auto"/> <!-- Add Button -->
                        </Grid.ColumnDefinitions>

                        <!-- 1. Ornament Dropdown -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Ornament (நகை வகை) (*):" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbOrnamentType" Height="36" IsEditable="True" TabIndex="9"
                                      ToolTip="Select from list of ornaments or type custom name"/>
                        </StackPanel>

                        <!-- 2. Qty -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Qty (*):" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtItemQty" Text="1" Height="36" HorizontalContentAlignment="Right" TabIndex="10"
                                     PreviewKeyDown="OnEntryFieldKeyDown"/>
                        </StackPanel>

                        <!-- 3. Gross Wt -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Gross (g) (*):" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtItemGross" Text="" Height="36" HorizontalContentAlignment="Right" TabIndex="11"
                                     TextChanged="OnManualWeightChanged" PreviewKeyDown="OnEntryFieldKeyDown"/>
                        </StackPanel>

                        <!-- 4. Deduct Wt -->
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="Deduct (g):" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtItemDeduct" Text="0.000" Height="36" HorizontalContentAlignment="Right" TabIndex="12"
                                     TextChanged="OnManualWeightChanged" PreviewKeyDown="OnEntryFieldKeyDown"/>
                        </StackPanel>

                        <!-- 5. Net Wt -->
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="Net (g):" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Height="36">
                                <TextBlock x:Name="TxtItemNet" Text="0.000 g" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryDeepBlueBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            </Border>
                        </StackPanel>

                        <!-- 6. Purity % -->
                        <StackPanel Grid.Column="5" Margin="0,0,8,0">
                            <TextBlock Text="Purity %:" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtItemPurity" Text="91.60" Height="36" HorizontalContentAlignment="Right" TabIndex="13"
                                     PreviewKeyDown="OnEntryFieldKeyDown"/>
                        </StackPanel>

                        <!-- 7. Rate/g -->
                        <StackPanel Grid.Column="6" Margin="0,0,8,0">
                            <TextBlock Text="Rate/g (₹):" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtItemRate" Text="5,500.00" Height="36" HorizontalContentAlignment="Right" TabIndex="14"
                                     PreviewKeyDown="OnEntryFieldKeyDown"/>
                        </StackPanel>

                        <!-- 8. Add Button -->
                        <StackPanel Grid.Column="7" VerticalAlignment="Bottom">
                            <Button x:Name="BtnAddOrnament" Content="+ Add to List" Height="36" Width="110"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="OnAddOrnamentClick" TabIndex="15"
                                    ToolTip="Add this ornament and weight to jewel lines"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <DataGrid x:Name="GridItems" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" TabIndex="16" MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Jewel Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Gross (g)" Binding="{Binding GrossWeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" Width="95" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Deduct (g)" Binding="{Binding DeductionWeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" Width="95" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Net (g)" Binding="{Binding NetWeight, StringFormat={}{0:F3}}" Width="95" IsReadOnly="True" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Purity %" Binding="{Binding PurityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Width="80" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Rate/g (₹)" Binding="{Binding RatePerGram, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="105" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Appraised Value (₹)" Binding="{Binding AppraisedValue, StringFormat={}{0:N2}}" Width="140" IsReadOnly="True" FontWeight="Bold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTemplateColumn Header="Action" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Width="30" Height="26" Style="{StaticResource DangerButtonStyle}"
                                            Click="OnRemoveJewelItemClick" ToolTip="Remove this jewel line"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary & Terms Section -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Total Net Weight:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalNet" Text="0.000 g" FontWeight="Bold" FontSize="18" Foreground="{StaticResource BrandGoldBrush}"/>
                    <TextBlock Text="Market Value:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtTotalValue" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                    <TextBlock Text="Max LTV Eligible:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtMaxEligible" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource SuccessGreenBrush}"/>
                    <TextBlock Text="Monthly Interest (Est):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtEstMonthlyInterest" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryDeepBlueBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4,0,12,0">
                    <TextBlock Text="Loan Amount Disbursed (₹) (*):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtLoanAmount" Height="36" FontSize="16" FontWeight="Bold" Text="0.00" TextChanged="OnLoanAmountChanged" TabIndex="11"/>
                    <TextBlock x:Name="TxtLoanAmountError" Text="Loan amount must be greater than zero." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtOverrideNotice" Text="⚠ Exceeds LTV! Owner Override needed." Foreground="{StaticResource DangerRedBrush}" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                    <TextBlock Text="Owner Override Reason:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtOverrideReason" Height="62" AcceptsReturn="True" TextWrapping="Wrap" TabIndex="12"/>
                    <TextBlock x:Name="TxtOverrideError" Text="Override reason is required when exceeding LTV." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="PrgSaving" Height="4" Width="140" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Form" Width="110" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearClick" Margin="0,0,10,0" TabIndex="13"/>
                <Button x:Name="BtnIssueLoan" Content="Disburse Loan &amp; Print Ticket" Width="240" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnIssueLoanClick" TabIndex="14"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
