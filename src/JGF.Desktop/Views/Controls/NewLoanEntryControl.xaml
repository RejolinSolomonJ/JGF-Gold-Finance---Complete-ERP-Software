<UserControl x:Class="JGF.Desktop.Views.Controls.NewLoanEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JGF.Desktop.Common"
             Background="{StaticResource AppBackgroundBrush}"
             common:KeyboardNavigationHelper.EnableEnterKeyNavigation="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Section -->
            <RowDefinition Height="Auto"/> <!-- Customer & Scheme Row Card -->
            <RowDefinition Height="*"/>    <!-- Collateral Jewel Breakdown Grid -->
            <RowDefinition Height="Auto"/> <!-- Summary & Loan Disbursal Card -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="NEW JEWEL LOAN ENTRY (புதிய நகை கடன் பதிவு)" Style="{StaticResource HeadingTextStyle}" Foreground="{StaticResource PrimaryDeepBlueBrush}" Margin="0,0,0,12"/>

        <!-- Customer & Scheme Selection Section -->
        <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Customer Search / Pick -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                    <TextBlock Text="Customer (* Name / Code / Mobile):" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel>
                        <Button Content="🔍 Select Customer" DockPanel.Dock="Right" Width="130" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnPickCustomerClick" TabIndex="1"/>
                        <TextBox x:Name="TxtCustomerSearch" IsReadOnly="True" Background="{StaticResource SurfaceAltBrush}" TabIndex="0"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtCustomerError" Text="Please select a customer." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Scheme -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,10,6">
                    <TextBlock Text="Loan Scheme (*):" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbScheme" SelectionChanged="OnSchemeChanged" TabIndex="2"/>
                </StackPanel>

                <!-- Pledge Date -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,10,6">
                    <TextBlock Text="Pledge Date:" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DpPledgeDate" TabIndex="3"/>
                </StackPanel>

                <!-- Packet Number -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0,0,6">
                    <TextBlock Text="Locker Packet / Barcode:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtPacket" Text="PKT-AUTO" TabIndex="4"/>
                </StackPanel>

                <!-- Nominee Row -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,10,0">
                    <TextBlock Text="Nominee Name:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtNominee" TabIndex="5"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,6,10,0">
                    <TextBlock Text="Relationship:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtNomineeRel" Text="Spouse" TabIndex="6"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,6,0,0" Grid.ColumnSpan="2">
                    <TextBlock Text="Jewel Scale Photo:" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel>
                        <Button Content="📷 Attach" DockPanel.Dock="Right" Width="90" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnAttachJewelPhotoClick" TabIndex="8"/>
                        <TextBox x:Name="TxtPhotoPath" IsReadOnly="True" Background="{StaticResource SurfaceAltBrush}" TabIndex="7"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Jewel Items Collateral Grid -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" Padding="12,8" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Collateral Jewels Breakdown (நகைகள் விவரம்)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="+ Add Jewel Line" DockPanel.Dock="Right" Width="140" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddJewelItemClick" TabIndex="9"/>
                    </DockPanel>
                </Border>
                
                <DataGrid x:Name="GridItems" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" TabIndex="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Jewel Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="65" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Gross (g)" Binding="{Binding GrossWeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" Width="100" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Deduct (g)" Binding="{Binding DeductionWeight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F3}}" Width="100" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Net (g)" Binding="{Binding NetWeight, StringFormat={}{0:F3}}" Width="100" IsReadOnly="True" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Purity %" Binding="{Binding PurityPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" Width="85" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Rate/g (₹)" Binding="{Binding RatePerGram, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="110" 
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                        <DataGridTextColumn Header="Appraised Value (₹)" Binding="{Binding AppraisedValue, StringFormat={}{0:N2}}" Width="150" IsReadOnly="True" FontWeight="Bold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary & Terms Section -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Total Net Weight:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalNet" Text="0.000 g" FontWeight="Bold" FontSize="18" Foreground="{StaticResource BrandGoldBrush}"/>
                    <TextBlock Text="Market Value:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtTotalValue" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                    <TextBlock Text="Max LTV Eligible:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="TxtMaxEligible" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource SuccessGreenBrush}"/>
                    <TextBlock Text="Monthly Interest (Est):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtEstMonthlyInterest" Text="₹ 0.00" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryDeepBlueBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4,0,12,0">
                    <TextBlock Text="Loan Amount Disbursed (₹) (*):" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtLoanAmount" Height="36" FontSize="16" FontWeight="Bold" Text="0.00" TextChanged="OnLoanAmountChanged" TabIndex="11"/>
                    <TextBlock x:Name="TxtLoanAmountError" Text="Loan amount must be greater than zero." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtOverrideNotice" Text="⚠ Exceeds LTV! Owner Override needed." Foreground="{StaticResource DangerRedBrush}" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                    <TextBlock Text="Owner Override Reason:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TxtOverrideReason" Height="62" AcceptsReturn="True" TextWrapping="Wrap" TabIndex="12"/>
                    <TextBlock x:Name="TxtOverrideError" Text="Override reason is required when exceeding LTV." Style="{StaticResource InlineErrorTextStyle}" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="PrgSaving" Height="4" Width="140" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear Form" Width="110" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearClick" Margin="0,0,10,0" TabIndex="13"/>
                <Button x:Name="BtnIssueLoan" Content="Disburse Loan &amp; Print Ticket" Width="240" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnIssueLoanClick" TabIndex="14"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
