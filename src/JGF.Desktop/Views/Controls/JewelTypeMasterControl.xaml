<UserControl x:Class="JGF.Desktop.Views.Controls.JewelTypeMasterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Content="+ New Type" DockPanel.Dock="Right" Background="#B8860B" Click="OnNewTypeClick"/>
                    <TextBlock Text="JEWEL TYPES" FontWeight="Bold" FontSize="16" Foreground="#B8860B"/>
                </DockPanel>
                <DataGrid x:Name="GridJewelTypes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="OnTypeSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="60"/>
                        <DataGridTextColumn Header="Jewel Name" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Jewel Master Details" FontWeight="Bold" FontSize="16"/>
            <Separator Margin="0,8"/>

            <TextBlock Text="Jewel Code:"/>
            <TextBox x:Name="TxtCode" Text="CH"/>

            <TextBlock Text="Jewel Name / நகையின் பெயர்:" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtName" Text="Gold Chain"/>

            <TextBlock Text="Description:" Margin="0,8,0,0"/>
            <TextBox x:Name="TxtDesc" Height="60" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Soft Delete" Background="#C62828" Click="OnDeleteClick" Width="100"/>
                <Button Content="Save Jewel Type" Background="#2E7D32" FontWeight="Bold" Click="OnSaveClick" Width="140"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

