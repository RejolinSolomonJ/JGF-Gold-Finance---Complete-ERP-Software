<UserControl x:Class="JGF.Desktop.Views.Controls.LoanDirectoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundLightBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header Card -->
            <RowDefinition Height="Auto"/> <!-- 5 KPI Summary Stat Cards -->
            <RowDefinition Height="Auto"/> <!-- Search & Filter Toolbar Card -->
            <RowDefinition Height="*"/>    <!-- All Loans DataGrid Table -->
            <RowDefinition Height="Auto"/> <!-- Bottom Summary & Export Bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Header Card -->
        <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,12" Padding="16,12" Background="#FFFFFF">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="18" Foreground="#1E40AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALL LOANS &amp; STATUS DIRECTORY (அனைத்து கடன்கள் மற்றும் நிலை)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryDeepBlueBrush}"/>
                        <TextBlock Text="Complete portfolio of all gold loans disbursed, repayment progress, and closure status (Active vs. Closed)" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="📥 Export CSV" Width="120" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnExportCsvClick"/>
                    <Button Content="🖨 Print Directory" Width="130" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="OnPrintDirectoryClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: 5 Top KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Loans Disbursed -->
            <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Margin="0,0,6,0" Padding="12,10" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL DISBURSED (வழங்கியவை)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtKpiTotalCount" Text="0 Loans" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtKpiTotalAmount" Text="₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Active Loans -->
            <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Margin="3,0,3,0" Padding="12,10" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE LOANS (நடப்பு கடன்கள்)" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock x:Name="TxtKpiActiveCount" Text="0 Loans" FontSize="16" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtKpiActiveBalance" Text="Bal: ₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Partially Paid -->
            <Border Grid.Column="2" Style="{StaticResource ModernCardStyle}" Margin="3,0,3,0" Padding="12,10" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PARTIALLY PAID (பகுதி செலுத்தியவை)" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock x:Name="TxtKpiPartiallyPaidCount" Text="0 Loans" FontSize="16" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtKpiPartPrincipalPaid" Text="Paid: ₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Completely Closed -->
            <Border Grid.Column="3" Style="{StaticResource ModernCardStyle}" Margin="3,0,3,0" Padding="12,10" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COMPLETELY CLOSED (அடைக்கப்பட்டவை)" FontSize="10" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock x:Name="TxtKpiClosedCount" Text="0 Closed" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtKpiClosedAmount" Text="100% Settled" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Overdue -->
            <Border Grid.Column="4" Style="{StaticResource ModernCardStyle}" Margin="6,0,0,0" Padding="12,10" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OVERDUE (தவணை தவறியவை)" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock x:Name="TxtKpiOverdueCount" Text="0 Overdue" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtKpiOverdueAmount" Text="Due: ₹ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Search & Filter Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Margin="0,0,0,12" Padding="14,10" Background="#F8FAFC">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Search Box -->
                <StackPanel Orientation="Vertical" Margin="0,0,12,4">
                    <TextBlock Text="Search (GL No / Customer / Mobile):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSearchQuery" Width="220" Height="32" VerticalContentAlignment="Center" KeyDown="OnSearchKeyDown"/>
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Orientation="Vertical" Margin="0,0,12,4">
                    <TextBlock Text="Status Filter (நிலை):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbStatusFilter" Width="180" Height="32" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="All Loans (அனைத்தும்)"/>
                        <ComboBoxItem Content="Active Only (நடப்பு மட்டும்)"/>
                        <ComboBoxItem Content="Partially Paid (பகுதி செலுத்தப்பட்டவை)"/>
                        <ComboBoxItem Content="Completely Closed (முழு அடைப்பு)"/>
                        <ComboBoxItem Content="Overdue Loans (தவணை தவறியவை)"/>
                        <ComboBoxItem Content="Auctioned (ஏலம் விடப்பட்டவை)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Scheme Filter -->
                <StackPanel Orientation="Vertical" Margin="0,0,12,4">
                    <TextBlock Text="Scheme Filter:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbSchemeFilter" Width="160" Height="32" SelectedIndex="0" SelectionChanged="OnFilterChanged"/>
                </StackPanel>

                <!-- Date Range -->
                <StackPanel Orientation="Vertical" Margin="0,0,8,4">
                    <TextBlock Text="From Date:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                    <DatePicker x:Name="DpFromDate" Width="125" Height="32" SelectedDateChanged="OnFilterChanged"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,12,4">
                    <TextBlock Text="To Date:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                    <DatePicker x:Name="DpToDate" Width="125" Height="32" SelectedDateChanged="OnFilterChanged"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button Content="🔍 Apply Filter" Width="110" Height="32" Style="{StaticResource PrimaryButtonStyle}" Click="OnApplyFilterClick" Margin="0,0,6,0"/>
                    <Button Content="🔄 Reset" Width="80" Height="32" Style="{StaticResource SecondaryButtonStyle}" Click="OnResetFilterClick"/>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Row 3: All Loans DataGrid Table -->
        <Border Grid.Row="3" Style="{StaticResource ModernCardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FAFC" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="TxtTableSummary" Text="Showing 0 Loans" FontWeight="Bold" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                        <TextBlock Text="💡 Double click any loan to view transaction timeline and sub-ledger" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="GridLoans" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" RowHeight="36" AlternatingRowBackground="#F8FAFC"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0" Background="White"
                          MouseDoubleClick="OnGridRowDoubleClick">
                    <DataGrid.Columns>
                        
                        <!-- GL Number -->
                        <DataGridTextColumn Header="GL Number" Binding="{Binding LoanNumber}" FontWeight="Bold" Width="175" MinWidth="165"/>

                        <!-- Customer -->
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerDisplayName}" Width="180" MinWidth="160" FontWeight="SemiBold"/>

                        <!-- Mobile -->
                        <DataGridTextColumn Header="Mobile Number" Binding="{Binding CustomerMobile}" Width="130" MinWidth="120"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>

                        <!-- Pledge Date -->
                        <DataGridTextColumn Header="Pledged Date" Binding="{Binding PledgeDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="120" MinWidth="110"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>

                        <!-- Scheme -->
                        <DataGridTextColumn Header="Scheme &amp; Rate" Binding="{Binding SchemeInfo}" Width="160" MinWidth="140"/>

                        <!-- Jewels & Weight -->
                        <DataGridTextColumn Header="Pledged Jewels (Net Wt)" Binding="{Binding JewelDetails}" Width="240" MinWidth="180"/>

                        <!-- Loan Given (Disbursed) -->
                        <DataGridTextColumn Header="Loan Given (₹)" Binding="{Binding DisbursedAmount, StringFormat={}{0:N2}}" Width="135" MinWidth="125" FontWeight="Bold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedDataGridCellText}">
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Principal Repaid -->
                        <DataGridTextColumn Header="Principal Repaid (₹)" Binding="{Binding PrincipalPaid, StringFormat={}{0:N2}}" Width="135" MinWidth="125"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>

                        <!-- Remaining Balance -->
                        <DataGridTemplateColumn Header="Remaining Bal (₹)" Width="145" MinWidth="135" HeaderStyle="{StaticResource RightAlignedDataGridHeader}"
                                                ClipboardContentBinding="{Binding RemainingPrincipal, StringFormat={}{0:N2}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RemainingPrincipal, StringFormat={}{0:N2}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                        <Setter Property="Text" Value="₹ 0.00 (Closed)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- This Month Due -->
                        <DataGridTextColumn Header="Monthly Due (₹)" Binding="{Binding MonthlyInterest, StringFormat={}{0:N2}}" Width="130" MinWidth="120" FontWeight="SemiBold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedDataGridCellText}">
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Accrued Interest -->
                        <DataGridTextColumn Header="Accrued Int (₹)" Binding="{Binding AccruedInterest, StringFormat={}{0:N2}}" Width="130" MinWidth="120"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}" ElementStyle="{StaticResource RightAlignedDataGridCellText}"/>

                        <!-- Pay to Close Now -->
                        <DataGridTextColumn Header="Pay to Close (₹)" Binding="{Binding PayToCloseNow, StringFormat={}{0:N2}}" Width="140" MinWidth="130" FontWeight="Bold"
                                            HeaderStyle="{StaticResource RightAlignedDataGridHeader}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedDataGridCellText}">
                                    <Setter Property="Foreground" Value="#15803D"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status (நிலை)" Width="140" MinWidth="130" HeaderStyle="{StaticResource CenterAlignedDataGridHeader}"
                                                ClipboardContentBinding="{Binding StatusText}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding BadgeBackground}">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Closed / Last Paid Date -->
                        <DataGridTextColumn Header="Settled / Paid" Binding="{Binding ClosedOrLastPaidText}" Width="130" MinWidth="120"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>

                        <!-- Packet # -->
                        <DataGridTextColumn Header="Packet #" Binding="{Binding PacketNumber}" Width="110" MinWidth="100"
                                            HeaderStyle="{StaticResource CenterAlignedDataGridHeader}" ElementStyle="{StaticResource CenterAlignedDataGridCellText}"/>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Action" Width="150" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="⚡ Settle" Height="26" Padding="6,0" Style="{StaticResource PrimaryButtonStyle}" FontSize="11"
                                                Click="OnSettleLoanRowClick" IsEnabled="{Binding IsOpen}" Margin="0,0,4,0" ToolTip="Open receipt entry to collect interest or full closure"/>
                                        <Button Content="📜 Ledger" Height="26" Padding="6,0" Style="{StaticResource SecondaryButtonStyle}" FontSize="11"
                                                Click="OnViewHistoryRowClick" ToolTip="View chronological ledger timeline"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Row 4: Bottom Summary Bar -->
        <Border Grid.Row="4" Style="{StaticResource ModernCardStyle}" Margin="0,10,0,0" Padding="12,10" Background="#FFFFFF">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="📌 STATUS GUIDE: " FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                    <Border Background="#DCFCE7" CornerRadius="3" Padding="4,2" Margin="4,0"><TextBlock Text="🟢 Closed (முழு அடைப்பு)" FontSize="10" FontWeight="Bold" Foreground="#166534"/></Border>
                    <Border Background="#EFF6FF" CornerRadius="3" Padding="4,2" Margin="4,0"><TextBlock Text="🔵 Active (நடப்பு)" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/></Border>
                    <Border Background="#FEF3C7" CornerRadius="3" Padding="4,2" Margin="4,0"><TextBlock Text="🟡 Partially Paid (பகுதி அடைப்பு)" FontSize="10" FontWeight="Bold" Foreground="#B45309"/></Border>
                    <Border Background="#FEE2E2" CornerRadius="3" Padding="4,2" Margin="4,0"><TextBlock Text="🔴 Overdue (தவணை தவறியவை)" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/></Border>
                </StackPanel>

                <TextBlock x:Name="TxtFooterAggregate" Text="Total Loans: 0 | Disbursed: ₹ 0.00 | Open Bal: ₹ 0.00 | Closed: 0"
                           FontWeight="SemiBold" FontSize="11" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>

