<Window x:Class="JGF.Desktop.Views.PastReceiptsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Past Receipts History — JGF"
        Width="780" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml"/>
                <ResourceDictionary Source="../Themes/Fonts.xaml"/>
                <ResourceDictionary Source="../Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- DataGrid of Receipts -->
            <RowDefinition Height="Auto"/> <!-- Footer Close -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📜" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Receipts History for Loan" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryDeepBlueBrush}"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Customer Name • Mobile" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Receipts DataGrid -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,0,0,12">
            <DataGrid x:Name="GridReceipts" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Receipt No" Binding="{Binding ReceiptNumber}" Width="150" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ReceiptDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ReceiptType}" Width="120"/>
                    <DataGridTextColumn Header="Principal (₹)" Binding="{Binding PrincipalAmount, StringFormat={}{0:N2}}" Width="110"
                                        HeaderStyle="{DynamicResource RightAlignedDataGridHeader}" ElementStyle="{DynamicResource RightAlignedDataGridCellText}"/>
                    <DataGridTextColumn Header="Interest (₹)" Binding="{Binding InterestAmount, StringFormat={}{0:N2}}" Width="110"
                                        HeaderStyle="{DynamicResource RightAlignedDataGridHeader}" ElementStyle="{DynamicResource RightAlignedDataGridCellText}"/>
                    <DataGridTextColumn Header="Total (₹)" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="110" FontWeight="Bold"
                                        HeaderStyle="{DynamicResource RightAlignedDataGridHeader}" ElementStyle="{DynamicResource RightAlignedDataGridCellText}"/>
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="🖨️ Print" Width="68" Height="26" FontSize="11" Margin="2,0"
                                            Style="{DynamicResource SecondaryButtonStyle}" Click="OnPrintRowClick"/>
                                    <Button Content="💾 PDF" Width="62" Height="26" FontSize="11" Margin="2,0"
                                            Style="{DynamicResource SecondaryButtonStyle}" Click="OnDownloadRowClick"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button Content="Close" DockPanel.Dock="Right" Width="90" Height="34"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="OnCloseClick" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>

