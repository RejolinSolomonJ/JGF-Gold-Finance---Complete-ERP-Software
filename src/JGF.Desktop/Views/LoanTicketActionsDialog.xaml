<Window x:Class="JGF.Desktop.Views.LoanTicketActionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JGF — Jewel Loan Pawn Ticket &amp; Mortgage Deed (ரசீது &amp; கடன் பத்திரம்)"
        Width="980" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml"/>
                <ResourceDictionary Source="../Themes/Fonts.xaml"/>
                <ResourceDictionary Source="../Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Success Banner -->
            <RowDefinition Height="Auto"/> <!-- Sheet Selector Bar -->
            <RowDefinition Height="*"/>    <!-- Scrollable Visual Preview -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <TextBlock Text="✔️" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSuccessTitle" Text="Jewel Loan Disbursed Successfully!" FontWeight="Bold" FontSize="15" Foreground="#166534"/>
                    <TextBlock x:Name="TxtSuccessSubtitle" Text="Loan #... • Pawn Ticket &amp; Mortgage Deed Ready for Print &amp; Download" FontSize="12" Foreground="#15803D"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Sheet Toggle Selector -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Document Sheet:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0" Foreground="#334155"/>
                
                <RadioButton x:Name="RbSheet1" Content="Sheet 1: Jewel Inventory &amp; Customer Receipt (ரசீது &amp; நகைப் பட்டியல்)"
                             IsChecked="True" GroupName="SheetGroup" FontWeight="SemiBold" FontSize="12" Margin="0,0,18,0"
                             VerticalAlignment="Center" Checked="OnSheetSelectionChanged"/>

                <RadioButton x:Name="RbSheet2" Content="Sheet 2: Legal Mortgage Deed &amp; Ledger (அடமானக் கடன் பத்திரம் &amp; தவணை அட்டவணை)"
                             GroupName="SheetGroup" FontWeight="SemiBold" FontSize="12"
                             VerticalAlignment="Center" Checked="OnSheetSelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- 3. Scrollable Visual Document Preview Container -->
        <Border Grid.Row="2" Background="#E2E8F0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                <ContentPresenter x:Name="PnlPreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <!-- 4. Action Buttons Footer -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnClose" Content="Close" DockPanel.Dock="Left" Width="100" Height="38"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnCloseClick" IsCancel="True"/>

                <Button x:Name="BtnDownloadPdf" Content="💾 Download PDF (Complete 2-Page)" DockPanel.Dock="Right" Width="230" Height="38" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnDownloadPdfClick"/>

                <Button x:Name="BtnPrintBoth" Content="🖨️ Print Both Sheets (Duplex)" DockPanel.Dock="Right" Width="190" Height="38" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnPrintBothClick"/>

                <Button x:Name="BtnPrintCurrent" Content="🖨️ Print Selected Sheet" DockPanel.Dock="Right" Width="180" Height="38" Margin="8,0,0,0"
                        Style="{DynamicResource PrimaryButtonStyle}" Click="OnPrintCurrentClick"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

