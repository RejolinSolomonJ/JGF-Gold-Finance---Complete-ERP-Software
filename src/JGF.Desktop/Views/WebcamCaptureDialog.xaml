<Window x:Class="JGF.Desktop.Views.WebcamCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Camera Capture (வெப்கேம் புகைப்படம்)"
        Width="580" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml"/>
                <ResourceDictionary Source="../Themes/Fonts.xaml"/>
                <ResourceDictionary Source="../Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Camera selector -->
            <RowDefinition Height="*"/>    <!-- Video / Snapshot Viewfinder -->
            <RowDefinition Height="Auto"/> <!-- Status message -->
            <RowDefinition Height="Auto"/> <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Header & Camera Select -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <TextBlock Text="Live Camera Viewfinder"
                       FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource PrimaryDeepBlueBrush}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbCameras" Width="180" Height="32" SelectionChanged="OnCameraSelectionChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- Viewfinder Card -->
        <Border Grid.Row="1" Background="#111827" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <Grid>
                <!-- Live Preview Stream -->
                <Image x:Name="ImgLivePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Frozen Snapshot (shown when captured) -->
                <Image x:Name="ImgSnapshot" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Viewfinder Guideline Frame -->
                <Border x:Name="BdrGuide" BorderBrush="#40FFFFFF" BorderThickness="1.5" CornerRadius="8" Margin="40" IsHitTestVisible="False"/>

                <!-- No Camera / Loading Placeholder -->
                <StackPanel x:Name="PnlCameraStatus" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtCameraStatus" Text="Looking for camera devices..." FontSize="14" Foreground="#E5E7EB" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                    <Button Content="📁 Browse File from PC" Margin="0,16,0,0" Width="180" Height="34" Style="{DynamicResource SecondaryButtonStyle}" Click="OnBrowseFileClick" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status / Help text -->
        <TextBlock x:Name="TxtInfo" Grid.Row="2" Text="Align the subject inside the frame and click 'Take Photo'."
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,10,0,12"/>

        <!-- Controls / Buttons -->
        <Border Grid.Row="3" Background="#FFFFFF" Padding="12,10" CornerRadius="8" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnBrowse" Content="📁 Choose File" DockPanel.Dock="Left" Width="120" Height="36"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnBrowseFileClick"/>

                <Button x:Name="BtnCancel" Content="Cancel" DockPanel.Dock="Right" Width="90" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnCancelClick" IsCancel="True"/>

                <Button x:Name="BtnAccept" Content="✔️ Use Photo" DockPanel.Dock="Right" Width="120" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource PrimaryButtonStyle}" Click="OnAcceptClick" Visibility="Collapsed"/>

                <Button x:Name="BtnRetake" Content="🔄 Retake" DockPanel.Dock="Right" Width="100" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnRetakeClick" Visibility="Collapsed"/>

                <Button x:Name="BtnCapture" Content="📸 Take Photo" DockPanel.Dock="Right" Width="130" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource PrimaryButtonStyle}" Click="OnCaptureClick"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
