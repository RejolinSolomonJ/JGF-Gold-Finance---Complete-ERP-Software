<Window x:Class="JGF.Desktop.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JGF — User Login" Height="520" Width="440"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#252526" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/logo.png" Height="96" Width="96" HorizontalAlignment="Center" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="JEBA GOLD FINANCE" FontSize="18" FontWeight="Bold" Foreground="#DAA520" HorizontalAlignment="Center"/>
            <TextBlock Text="Pawn &amp; Gold Loan System (தமிழ்நாடு)" FontSize="11" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Text="Default Login: admin / Admin@123" FontSize="11" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Username / பயனர் பெயர்:" Foreground="#CCCCCC" Margin="0,4"/>
            <TextBox x:Name="TxtUsername" Height="32" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="White" BorderBrush="#444444"/>

            <TextBlock Text="Password / கடவுச்சொல்:" Foreground="#CCCCCC" Margin="0,12,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="32" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="White" BorderBrush="#444444"/>

            <TextBlock x:Name="TxtError" Text="" Foreground="#FF6B6B" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Exit" Width="100" Height="36" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick" Margin="0,0,10,0"/>
            <Button Content="Login" Width="130" Height="36" Style="{StaticResource PrimaryButtonStyle}" Click="OnLoginClick" IsDefault="True"/>
        </StackPanel>

        <!-- Footer Developer Branding -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,10,0,0" BorderBrush="#383838" BorderThickness="0,1,0,0">
            <TextBlock HorizontalAlignment="Center" Cursor="Hand" ToolTip="Click to visit https://www.linsinfotech.in" MouseLeftButtonDown="OnLinInfotechLinkClick">
                <Run Text="Developed by " Foreground="#888888" FontSize="11"/>
                <Run Text="Lin's Infotech Company Ltd." Foreground="#38BDF8" FontWeight="Bold" TextDecorations="Underline" FontSize="11"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>

