<Window x:Class="JGF.Desktop.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About JGF &amp; System Version History"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9F9"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161A1D" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Height="52" Width="52" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JGF — Jeba Gold Finance (தமிழ்நாடு)" 
                                   FontSize="18" FontWeight="Bold" Foreground="#DAA520"/>
                        <TextBlock Text="Pawn Broking &amp; Jewel Loan ERP System — Production Edition" 
                                   FontSize="12" Foreground="#A0AEC0" Margin="0,2,0,0"/>
                        <TextBlock Text="TRUST • TRANSPARENCY • PROSPERITY" 
                                   FontSize="10" Foreground="#718096" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAppVersion" Text="App Version: 1.2.0" 
                               FontWeight="Bold" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtDbVersion" Text="Database: 1.2.0" 
                               Foreground="#10B981" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Card -->
        <Border Grid.Row="1" x:Name="BorderVersionStatus" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusHeadline" Text="● System Status: Fully Up to Date" 
                               FontWeight="Bold" Foreground="#065F46" FontSize="13"/>
                    <TextBlock x:Name="TxtStatusDetails" Text="App binary and database schema versions match. All data structures are synchronized." 
                               FontSize="11" Foreground="#047857" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnOpenUpdateWizard" Content="Launch Safe Update Wizard" 
                        Background="#D97706" Foreground="White" FontWeight="SemiBold" Padding="12,6" 
                        Click="OnOpenUpdateWizardClick" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Version & Migration History -->
        <GroupBox Grid.Row="2" Header="Schema Version &amp; Update History (PostgreSQL)" FontWeight="SemiBold" Margin="0,0,0,16">
            <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" Background="White" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal" SelectionMode="Single"
                      FontWeight="Normal" FontSize="12" Margin="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="80"/>
                    <DataGridTextColumn Header="Applied At (UTC)" Binding="{Binding AppliedAtUtc, StringFormat={}{0:dd-MMM-yyyy HH:mm}}" Width="130"/>
                    <DataGridTextColumn Header="Applied By" Binding="{Binding AppliedBy}" Width="100"/>
                    <DataGridTextColumn Header="Migrations Applied" Binding="{Binding AppliedMigrations}" Width="150"/>
                    <DataGridTextColumn Header="Integrity Check" Binding="{Binding IntegrityCheckStatus}" Width="160"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Footer -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock Cursor="Hand" ToolTip="Click to visit https://www.linsinfotech.in" MouseLeftButtonDown="OnLinInfotechLinkClick" VerticalAlignment="Center">
                <Run Text="Developed by " Foreground="#64748B" FontSize="12"/>
                <Run Text="Lin's Infotech Company Ltd." Foreground="#0284C7" FontWeight="Bold" TextDecorations="Underline" FontSize="12"/>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="Close" Width="100" Height="32" Click="OnCloseClick" 
                    Background="#E5E7EB" Foreground="#374151" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>

