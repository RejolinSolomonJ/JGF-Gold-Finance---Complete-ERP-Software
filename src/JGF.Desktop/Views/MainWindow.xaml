<Window x:Class="JGF.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="JGF — Jeba Gold Finance (தமிழ்நாடு)" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Brand Bar -->
            <RowDefinition Height="Auto"/> <!-- Main Menu Bar -->
            <RowDefinition Height="*"/>    <!-- Main Dynamic Content Workspace -->
            <RowDefinition Height="28"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Brand Header -->
        <Border Grid.Row="0" Background="#161A1D" Padding="14,8" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Height="42" Width="42" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="JEBA GOLD FINANCE" Foreground="#DAA520" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text=" | நகை கடன் நிதி மென்பொருள்" Foreground="#A0AEC0" FontSize="13" Margin="8,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="TRUST • TRANSPARENCY • PROSPERITY — YOUR TRUST OUR STRENGTH" Foreground="#718096" FontSize="10" FontWeight="SemiBold" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="User: " Foreground="#888888"/>
                    <TextBlock x:Name="TxtCurrentUser" Text="Admin (Owner)" Foreground="White" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Role: " Foreground="#888888"/>
                    <TextBlock x:Name="TxtCurrentRole" Text="Owner" Foreground="#4CAF50" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Date: " Foreground="#888888"/>
                    <TextBlock x:Name="TxtCurrentDate" Text="06-Nov-2026" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Menu Navigation Bar (Role-Based Visibility) -->
        <Menu Grid.Row="1" Background="#2D2D30" Foreground="White" FontSize="14" Padding="4">
            <MenuItem Header="⌂ _Dashboard (Home)" Click="OnDashboardClick"/>
            <MenuItem Header="_Member Detail (F1)" Click="OnCustomerMasterClick"/>
            <MenuItem Header="_New Loan Entry (F2)" Click="OnNewLoanClick"/>
            <MenuItem Header="_Customer Detail (F3)" Click="OnCustomerDetailClick"/>
            <MenuItem Header="_Receipt (F4)" Click="OnReceiptClick"/>
            <MenuItem Header="Re _Pledge (F5)" x:Name="MenuRepledge" Click="OnRepledgeClick"/>
            <MenuItem Header="_Notices &amp; Auction (F6)" x:Name="MenuNoticesAuction" Click="OnNoticesAuctionClick"/>
            <MenuItem Header="_Reports (F7)" Click="OnReportsClick"/>
            <MenuItem Header="_Stock (F8)" Click="OnStockClick"/>
            <MenuItem Header="_Accounts (F9)" x:Name="MenuAccounts">
                <MenuItem Header="Day Book" Click="OnDayBookClick"/>
                <MenuItem Header="Financial Reports (Trial Balance, P&amp;L, Balance Sheet)" Click="OnFinancialReportsClick"/>
                <MenuItem Header="Accounts Integrity Audit" Click="OnIntegrityCheckClick"/>
                <Separator/>
                <MenuItem Header="Ledger Heads Master" Click="OnLedgerHeadsClick"/>
                <MenuItem Header="Voucher Entry" Click="OnVouchersClick"/>
                <Separator/>
                <MenuItem Header="Day-End Close" Click="OnDayCloseClick"/>
            </MenuItem>
            <MenuItem Header="_Settings (F9)" x:Name="MenuSettings">
                <MenuItem Header="Schemes Master" Click="OnSchemesMasterClick"/>
                <MenuItem Header="Jewel Types &amp; Purity" Click="OnJewelTypesClick"/>
                <MenuItem Header="Daily Gold Rate" Click="OnGoldRateClick"/>
                <MenuItem Header="Banks &amp; NBFCs" Click="OnBanksMasterClick"/>
                <MenuItem Header="Number Series" Click="OnNumberSeriesClick"/>
                <Separator/>
                <MenuItem Header="Audit Trail (Owner Only)" x:Name="MenuAuditLog" Click="OnAuditLogClick"/>
                <MenuItem Header="Data Migration &amp; Legacy Import (Owner Only)" x:Name="MenuDataMigration" Click="OnDataMigrationClick"/>
                <MenuItem Header="Database Backup &amp; Test Restore" Click="OnBackupSettingsClick"/>
                <MenuItem Header="Database Connection Settings (PC2 / LAN)" Click="OnDbSettingsClick"/>
                <Separator/>
                <MenuItem Header="Safe Update Wizard (Owner / Manager)" x:Name="MenuSafeUpdate" Click="OnSafeUpdateWizardClick"/>
                <MenuItem Header="About JGF &amp; System Version" Click="OnAboutClick"/>
            </MenuItem>
            <MenuItem Header="E_xit (Alt+F4)" Click="OnExitClick"/>
        </Menu>

        <!-- 3. Dynamic Center Workspace Container -->
        <Border Grid.Row="2" Background="#F4F4F4" Padding="12">
            <ContentControl x:Name="MainContentArea"/>
        </Border>

        <!-- 4. Bottom Operational Status Bar -->
        <StatusBar Grid.Row="3" Background="#1E1E1E" Foreground="#CCCCCC">
            <StatusBarItem>
                <TextBlock x:Name="TxtDbStatus" Text="● DB: Connected (LAN PC1)" Foreground="#4CAF50"/>
            </StatusBarItem>
            <Separator Background="#444444"/>
            <StatusBarItem>
                <TextBlock x:Name="TxtBackupWarning" Text="Backup: Up to date" Foreground="#888888"/>
            </StatusBarItem>
            <Separator Background="#444444"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Shortcuts: Tab=Next, Enter=Move, Esc=Close"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

