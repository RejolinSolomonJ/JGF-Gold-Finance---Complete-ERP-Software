<Window x:Class="JGF.Desktop.Views.SafeUpdateWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JGF Safe Update Wizard — Production Upgrade Engine"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="620" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Banner -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="JGF Production Safe Update System" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                <TextBlock Text="Strict 4-Step Upgrade Protocol with Automated Verified Pre-Update Backup &amp; Integrity Audit" 
                           FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Step-by-Step Stepper Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Step 1 -->
            <Border Grid.Column="0" x:Name="CardStep1" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Step 1: Close Day" FontWeight="Bold" FontSize="12" Foreground="#374151"/>
                    <TextBlock Text="Reconcile Cash &amp; Finalize Day" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtStep1Status" Text="● Checking..." FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Step 2 -->
            <Border Grid.Column="1" x:Name="CardStep2" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Step 2: Backup" FontWeight="Bold" FontSize="12" Foreground="#374151"/>
                    <TextBlock Text="Verified Encrypted Snapshot" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtStep2Status" Text="● Pending" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Step 3 -->
            <Border Grid.Column="2" x:Name="CardStep3" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Step 3: Update PC1" FontWeight="Bold" FontSize="12" Foreground="#374151"/>
                    <TextBlock Text="Transactional Migration" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtStep3Status" Text="● Pending" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Step 4 -->
            <Border Grid.Column="3" x:Name="CardStep4" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Step 4: Update PC2" FontWeight="Bold" FontSize="12" Foreground="#374151"/>
                    <TextBlock Text="Integrity &amp; Client Sync" FontSize="10" Foreground="#6B7280" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TxtStep4Status" Text="● Pending" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Work Area -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Warning / Info Box -->
                <Border Grid.Row="0" x:Name="BorderAlert" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtAlertMessage" 
                               Text="Safety Rules: Updates must occur on PC1 Server. Backups are non-skippable. Day must be closed." 
                               Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Live Progress Logs -->
                <TextBox Grid.Row="1" x:Name="TxtLogOutput" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         Background="#18181B" Foreground="#22C55E" FontFamily="Consolas" FontSize="12" Padding="10"
                         TextWrapping="Wrap"/>

                <!-- Encryption Key Entry (Required for Pre-Update Backup) -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Backup Encryption Passphrase: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <PasswordBox Grid.Column="1" x:Name="TxtBackupPassword" Password="JgfMasterBackupKey2026!#" Padding="6,4"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TxtFooterStatus" Text="Ready to check prerequisites..." 
                       VerticalAlignment="Center" Foreground="#6B7280" FontSize="12"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnVerifyPreconditions" Content="1. Re-Check Safety Rules" Padding="14,6" Margin="0,0,8,0"
                        Background="#E5E7EB" Foreground="#374151" FontWeight="SemiBold" Click="OnVerifyPreconditionsClick"/>
                <Button x:Name="BtnRunUpdate" Content="2. Start Safe Update &amp; Backup" Padding="16,6" Margin="0,0,8,0"
                        Background="#D97706" Foreground="White" FontWeight="Bold" Click="OnRunUpdateClick"/>
                <Button Content="Close" Padding="14,6" Background="#9CA3AF" Foreground="White" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

