<Window x:Class="JGF.Desktop.Views.ReceiptActionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JGF Receipt — Print &amp; Download"
        Width="580" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Colors.xaml"/>
                <ResourceDictionary Source="../Themes/Fonts.xaml"/>
                <ResourceDictionary Source="../Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Status -->
            <RowDefinition Height="*"/>    <!-- Scrollable Visual Preview -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#DCFCE7" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="✔️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSuccessTitle" Text="Receipt Processed Successfully!" FontWeight="Bold" FontSize="15" Foreground="#166534"/>
                    <TextBlock x:Name="TxtSuccessSubtitle" Text="Receipt #REC-AUTO • Ready to Print or Download" FontSize="12" Foreground="#15803D"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Receipt Preview Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="PnlPreviewContainer" Margin="16" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons Footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnClose" Content="Close" DockPanel.Dock="Left" Width="90" Height="36"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnCloseClick" IsCancel="True"/>

                <Button x:Name="BtnDownloadSlip" Content="📥 Download Release Slip" DockPanel.Dock="Right" Width="180" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnDownloadSlipClick" Visibility="Collapsed"/>

                <Button x:Name="BtnDownloadPdf" Content="💾 Download PDF" DockPanel.Dock="Right" Width="140" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}" Click="OnDownloadPdfClick"/>

                <Button x:Name="BtnDirectPrint" Content="🖨️ Send Directly to Print" DockPanel.Dock="Right" Width="180" Height="36" Margin="8,0,0,0"
                        Style="{DynamicResource PrimaryButtonStyle}" Click="OnDirectPrintClick"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

