<Application x:Class="JGF.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JGF.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Fonts.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Legacy Compatibility Brushes -->
            <SolidColorBrush x:Key="PrimaryGoldBrush" Color="#B8860B"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="AccentGoldBrush" Color="#DAA520"/>
            <FontFamily x:Key="TamilFont">pack://application:,,,/Assets/Fonts/#Noto Sans Tamil, Segoe UI, Nirmala UI, Latha</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
